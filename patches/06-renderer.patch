+/*
+@@@@@@@@@@@@@@@@@@@@@
+RE_SetWorldHoles
+
+The client passes the current world holes before each scene.
+@@@@@@@@@@@@@@@@@@@@@
+*/
+void R_SetWorldHoleBounds( void );
+
+void RE_SetWorldHoles( int numHoles, const float *holes ) {
+	if ( numHoles < 0 ) {
+		numHoles = 0;
+	}
+	if ( numHoles > MAX_RENDER_HOLES ) {
+		numHoles = MAX_RENDER_HOLES;
+	}
+
+	if ( numHoles == tr.numWorldHoles && !memcmp( tr.worldHoles, holes, numHoles * sizeof( vec4_t ) * 2 ) ) {
+		return;
+	}
+
+	tr.numWorldHoles = numHoles;
+	Com_Memcpy( tr.worldHoles, holes, numHoles * sizeof( vec4_t ) * 2 );
+	tr.worldHolesGeneration++;
+	R_SetWorldHoleBounds();
+}
+
+
+#define	HOLE_MASK_GRID		64		// points per hole side, WORLD_HOLE_GRID
+#define	HOLE_MASK_TILES		16		// tiles per mask side
+#define	HOLE_MASK_SIZE		( HOLE_MASK_GRID * HOLE_MASK_TILES )
+#define	HOLE_MASK_CELL		8		// units between points, WORLD_HOLE_CELL
+#define	HOLE_MASK_BIAS		64		// added to carved depths, WORLD_HOLE_BIAS
+#define	HOLE_MASK_CARVED	2		// shallower than this the shaders leave the wall alone
+
+/*
+=============
+R_SetWorldHoleBounds
+
+Puts a box around the carved part of every hole, from the extents of its mask and how deep it goes, so batches of world surfaces away from it skip it
+=============
+*/
+void R_SetWorldHoleBounds( void ) {
+	int		i, k;
+	float	*center, *axis, a, b, h;
+	vec3_t	u, v, p;
+	const int	*ext;
+
+	for ( i = 0 ; i < tr.numWorldHoles ; i++ ) {
+		ext = tr.worldHoleExtents[i];
+		tr.worldHoleCarved[i] = ext[0] <= ext[2];
+		if ( !tr.worldHoleCarved[i] ) {
+			continue;
+		}
+
+		center = tr.worldHoles[i * 2];
+		axis = tr.worldHoles[i * 2 + 1];
+
+		// the same axes the shaders read the mask along: floors along x and y, walls along the wall and up
+		if ( fabs( axis[2] ) > 0.5f ) {
+			VectorSet( u, 1, 0, 0 );
+			VectorSet( v, 0, 1, 0 );
+		} else {
+			VectorSet( u, -axis[1], axis[0], 0 );
+			VectorSet( v, 0, 0, 1 );
+		}
+
+		ClearBounds( tr.worldHoleBounds[i][0], tr.worldHoleBounds[i][1] );
+		for ( k = 0 ; k < 8 ; k++ ) {
+			// a cell past the carved points, as the depth interpolates into it
+			a = ( ( k & 1 ? ext[2] + 1 : ext[0] - 1 ) - HOLE_MASK_GRID / 2 ) * HOLE_MASK_CELL;
+			b = ( ( k & 2 ? ext[3] + 1 : ext[1] - 1 ) - HOLE_MASK_GRID / 2 ) * HOLE_MASK_CELL;
+			h = k & 4 ? 1 : -center[3];
+			VectorMA( center, a, u, p );
+			VectorMA( p, b, v, p );
+			VectorMA( p, h, axis, p );
+			AddPointToBounds( p, tr.worldHoleBounds[i][0], tr.worldHoleBounds[i][1] );
+		}
+
+		// the mask axes are not quite square to a sloped wall's normal
+		for ( k = 0 ; k < 3 ; k++ ) {
+			tr.worldHoleBounds[i][0][k] -= HOLE_MASK_CELL * 2;
+			tr.worldHoleBounds[i][1][k] += HOLE_MASK_CELL * 2;
+		}
+	}
+}
+
+/*
+@@@@@@@@@@@@@@@@@@@@@
+RE_SetWorldHoleMask
+
+Stores how deep each point of a hole is carved in the red channel of its tile.
+@@@@@@@@@@@@@@@@@@@@@
+*/
+void RE_SetWorldHoleMask( int tile, const byte *depths ) {
+	byte	pic[HOLE_MASK_GRID * HOLE_MASK_GRID * 4];
+	int		i, *ext;
+
+	if ( tile < 0 || tile >= HOLE_MASK_TILES * HOLE_MASK_TILES ) {
+		return;
+	}
+
+	if ( !tr.worldHoleMaskImage ) {
+		tr.worldHoleMaskImage = R_CreateImage( "*worldHoleMask", NULL, HOLE_MASK_SIZE, HOLE_MASK_SIZE, IMGTYPE_COLORALPHA,
+			IMGFLAG_NO_COMPRESSION | IMGFLAG_NOLIGHTSCALE | IMGFLAG_CLAMPTOEDGE, GL_RGBA8 );
+		qglTextureParameterfEXT( tr.worldHoleMaskImage->texnum, GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST );
+		qglTextureParameterfEXT( tr.worldHoleMaskImage->texnum, GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST );
+	}
+
+	ext = tr.worldHoleExtents[tile];
+	ext[0] = ext[1] = HOLE_MASK_GRID;
+	ext[2] = ext[3] = -1;
+	for ( i = 0 ; i < HOLE_MASK_GRID * HOLE_MASK_GRID ; i++ ) {
+		pic[i * 4 + 0] = depths[i];
+		pic[i * 4 + 1] = 0;
+		pic[i * 4 + 2] = 0;
+		pic[i * 4 + 3] = 255;
+
+		if ( depths[i] > HOLE_MASK_BIAS + HOLE_MASK_CARVED ) {
+			ext[0] = MIN( ext[0], i % HOLE_MASK_GRID );
+			ext[1] = MIN( ext[1], i / HOLE_MASK_GRID );
+			ext[2] = MAX( ext[2], i % HOLE_MASK_GRID );
+			ext[3] = MAX( ext[3], i / HOLE_MASK_GRID );
+		}
+	}
+	if ( tile < tr.numWorldHoles ) {
+		R_SetWorldHoleBounds();
+	}
+
+	R_UpdateSubImage( tr.worldHoleMaskImage, pic, ( tile % HOLE_MASK_TILES ) * HOLE_MASK_GRID,
+		( tile / HOLE_MASK_TILES ) * HOLE_MASK_GRID, HOLE_MASK_GRID, HOLE_MASK_GRID, GL_RGBA8 );
+}
