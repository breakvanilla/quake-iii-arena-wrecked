@@ -6,8 +6,48 @@ varying vec2      var_Tex1;
 varying vec4      var_Color;
 
 
+uniform int  u_NumWorldHoles;
+uniform vec4 u_WorldHoles[256];
+uniform sampler2D u_HoleMask;
+varying vec3 var_HolePos;
+
+// world holes: skip anything inside a crater blasted into a wall. each hole is a 64x64 grid of points 8 units apart on the wall, with the carved depth of each point (plus 64, see WORLD_HOLE_BIAS) in its mask tile, interpolated over two triangles per cell
+void CutWorldHoles()
+{
+	for (int i = 0; i < u_NumWorldHoles; i++)
+	{
+		vec4 center = u_WorldHoles[i * 2];
+		vec4 axis   = u_WorldHoles[i * 2 + 1];
+		vec3 delta  = var_HolePos - center.xyz;
+		float h     = dot(delta, axis.xyz);
+
+		if (h > 1.0 || h < -center.w)
+			continue;
+
+		// floors run along x and y, walls along the wall and up
+		vec2 g = (abs(axis.z) > 0.5 ? delta.xy : vec2(dot(delta.xy, vec2(-axis.y, axis.x)), delta.z)) / 8.0 + 32.0;
+		if (g.x < 0.0 || g.y < 0.0 || g.x >= 63.0 || g.y >= 63.0)
+			continue;
+
+		vec2 cell = floor(g);
+		vec2 f = g - cell;
+		vec2 tc = (vec2(mod(axis.w, 16.0), floor(axis.w / 16.0)) * 64.0 + cell + 0.5) / 1024.0;
+		float d00 = texture2D(u_HoleMask, tc).r;
+		float d10 = texture2D(u_HoleMask, tc + vec2(1.0 / 1024.0, 0.0)).r;
+		float d01 = texture2D(u_HoleMask, tc + vec2(0.0, 1.0 / 1024.0)).r;
+		float d11 = texture2D(u_HoleMask, tc + vec2(1.0 / 1024.0)).r;
+		float depth = 255.0 * (f.x >= f.y ? d00 + f.x * (d10 - d00) + f.y * (d11 - d10)
+		                                  : d00 + f.y * (d01 - d00) + f.x * (d11 - d01)) - 64.0;
+
+		if (depth > 2.0 && h > -depth)
+			discard;
+	}
+}
+
 void main()
 {
+	CutWorldHoles();
+
 	vec4 color = texture2D(u_DiffuseMap, var_Tex1);
 
 	float alpha = color.a * var_Color.a;
