+/*
+==============
+RB_StreamTessBuffer
+
+Maps size bytes of a buffer of the default VAO that the GPU is done with, starting over in a fresh buffer when this one is used up. Returns where they start in the buffer.
+==============
+*/
+static int RB_StreamTessBuffer(GLenum target, int *offset, int size, int bufferSize, byte **data)
+{
+	*offset = PAD(*offset, 16);
+	if (*offset + size > bufferSize)
+	{
+		qglBufferData(target, bufferSize, NULL, GL_DYNAMIC_DRAW);
+		*offset = 0;
+	}
+
+	*data = qglMapBufferRange(target, *offset, size, GL_MAP_WRITE_BIT | GL_MAP_INVALIDATE_RANGE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
+	*offset += size;
+	return *offset - size;
+}
