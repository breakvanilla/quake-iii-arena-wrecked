 		 					int listsize, int *lastLeaf );
 
 int			CM_LeafCluster (int leafnum);
+
+// cm_holes.c
+
+// a blasted wall or floor: a grid of points on its plane, each carved some depth behind it along -normal. Walls have a level normal, axis runs along the wall and up is world up; floors and ceilings have a normal of (0 0 +-1), axis (1 0 0) and up (0 1 0). Point (i,j) lies at origin + (i - WORLD_HOLE_GRID / 2) * WORLD_HOLE_CELL along axis and (j - WORLD_HOLE_GRID / 2) * WORLD_HOLE_CELL along up. Between the points the carved depth is interpolated over two triangles per cell, split along the diagonal from (i,j) to (i+1,j+1)
+#define	WORLD_HOLE_CELL		8
+#define	WORLD_HOLE_GRID		64
+#define	WORLD_HOLE_RIM		2		// shallower carving than this leaves the surface alone
+#define	WORLD_HOLE_BIAS		64		// depth[] holds carved depth + this; points outside the crater hold less, falling with their distance from its edge, so the interpolated depth reaches the rim right at the edge
+
+#define	HOLECELL_PROBED		1		// the flags below are known
+#define	HOLECELL_SOLID		2		// wall material right behind the plane
+#define	HOLECELL_EXPOSED	4		// and nothing in front of it, so it can be carved
+#define	HOLECELL_COLD		16		// last carved by something that leaves the rock cold
+#define	HOLECELL_PLASMA		32		// last carved by something that leaves it glowing blue-white
+
+typedef struct {
+	vec3_t		origin;
+	vec3_t		normal;
+	vec3_t		axis;
+	vec3_t		up;
+	float		maxDepth;		// deepest cut into the wall
+	int			serial;			// changes every time the carving does
+	byte		depth[WORLD_HOLE_GRID * WORLD_HOLE_GRID];		// biased, see WORLD_HOLE_BIAS
+	byte		flags[WORLD_HOLE_GRID * WORLD_HOLE_GRID];
+	char		material[MAX_QPATH];	// shader of the blasted surface, empty if unknown
+} worldHole_t;
+
+// what made a hole, which sets how it is carved and how the fresh rock glows
+typedef enum {
+	HOLE_BLAST,		// rockets: a rough crater that grows with every hit
+	HOLE_CHIP,		// bullets: a chip out of the surface, hits wear a pit into it
+	HOLE_MELT,		// plasma: a shallow molten pit
+	HOLE_DRILL		// railgun: a narrow, deep bore
+} holeKind_t;
+
+int			CM_AddWorldHole( const vec3_t origin, const vec3_t normal, float radius, holeKind_t kind );
+void		CM_ClearWorldHoles( void );
+int			CM_NumWorldHoles( void );
+const worldHole_t *CM_GetWorldHole( int num );
+qboolean	CM_SurfaceMaterial( const vec3_t impact, const vec3_t normal, char *material, int size );
 int			CM_LeafArea (int leafnum);
 
 void		CM_AdjustAreaPortalState( int area1, int area2, qboolean open );
