+
+
+// only world geometry is cut, entities keep their model space positions. Every hole costs each pixel drawn, so world surfaces only get the holes that reach them; other world batches, like crater linings and marks, get all of them. The sky box, clouds and sun are drawn around the view rather than in the world, so they are never cut.
+static void GLSL_SetWorldHoles(shaderProgram_t *program)
+{
+	static vec4_t holes[MAX_RENDER_HOLES * 2];
+	int bits[MAX_RENDER_HOLES / 32];
+	int count = 0, i;
+
+	Com_Memset(bits, 0, sizeof(bits));
+
+	if (backEnd.currentEntity == &tr.worldEntity && !(backEnd.refdef.rdflags & RDF_NOWORLDMODEL) && tr.worldHoleMaskImage
+		&& tess.shader && !tess.shader->isSky && tess.shader != tr.sunShader && tess.shader != tr.sunFlareShader)
+	{
+		for (i = 0; i < tr.numWorldHoles; i++)
+		{
+			if (tess.holeBoundsSet && (!tr.worldHoleCarved[i]
+				|| !BoundsIntersect(tess.holeBounds[0], tess.holeBounds[1], tr.worldHoleBounds[i][0], tr.worldHoleBounds[i][1])))
+				continue;
+
+			bits[i >> 5] |= 1 << (i & 31);
+			count++;
+		}
+	}
+
+	if (count)
+		GL_BindToTMU(tr.worldHoleMaskImage, TB_HOLEMASK);
+
+	if (count && !program->holeMaskSet && program->holeUniforms[2] != -1)
+	{
+		qglUniform1i(program->holeUniforms[2], TB_HOLEMASK);
+		program->holeMaskSet = qtrue;
+	}
+
+	if (count == program->holeCount && (!count || (program->holeGeneration == tr.worldHolesGeneration && !memcmp(bits, program->holeBits, sizeof(bits)))))
+		return;
+
+	program->holeCount = count;
+	program->holeGeneration = tr.worldHolesGeneration;
+	Com_Memcpy(program->holeBits, bits, sizeof(bits));
+
+	qglUniform1i(program->holeUniforms[0], count);
+	if (count && program->holeUniforms[1] != -1)
+	{
+		count = 0;
+		for (i = 0; i < tr.numWorldHoles; i++)
+		{
+			if (bits[i >> 5] & (1 << (i & 31)))
+			{
+				Vector4Copy(tr.worldHoles[i * 2], holes[count * 2]);
+				Vector4Copy(tr.worldHoles[i * 2 + 1], holes[count * 2 + 1]);
+				count++;
+			}
+		}
+		qglUniform4fv(program->holeUniforms[1], count * 2, holes[0]);
+	}
 }
 
 
