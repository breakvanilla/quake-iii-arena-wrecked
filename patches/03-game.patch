index d78afb0f7a362243660f5c61103944c11173c641..4abe49406a17c8e1df34bed762812eebb2f261a4 100644
--- a/code/game/g_weapon.c
+++ b/code/game/g_weapon.c
@@ -161,6 +161,37 @@ void SnapVectorTowards( vec3_t v, vec3_t to ) {
 #define	MACHINEGUN_DAMAGE	7
 #define	MACHINEGUN_TEAM_DAMAGE	5		// wimpier MG in teamplay
 
+/*
+================
+G_WorldHole
+
+Has the engine carve the world where a shot hit it; it decides what gives way
+================
+*/
+void G_WorldHole( const trace_t *trace, float radius, int kind ) {
+	float	args[7];
+	char	cmd[256];
+	int		i, n;
+
+	if ( g_destruction.value <= 0 || trace->entityNum != ENTITYNUM_WORLD || ( trace->surfaceFlags & SURF_NOIMPACT ) ) {
+		return;
+	}
+
+	// in hundredths: the QVM's %f sometimes mangles fractions and cuts the command short
+	for ( i = 0 ; i < 3 ; i++ ) {
+		args[i] = trace->endpos[i];
+		args[3 + i] = trace->plane.normal[i];
+	}
+	args[6] = radius;
+	Q_strncpyz( cmd, "addhole", sizeof( cmd ) );
+	for ( i = 0 ; i < 7 ; i++ ) {
+		n = (int)( fabs( args[i] ) * 100 + 0.5f );
+		Q_strcat( cmd, sizeof( cmd ), va( " %s%i.%02i", args[i] < 0 ? "-" : "", n / 100, n % 100 ) );
+	}
+	Q_strcat( cmd, sizeof( cmd ), va( " %i\n", kind ) );
+	trap_SendConsoleCommand( EXEC_NOW, cmd );
+}
+
