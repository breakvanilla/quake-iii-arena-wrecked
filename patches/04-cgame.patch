+/*
+==================
+CG_ShotWallDamage
+
+What smaller shots knock out of a wall: bullets and pellets kick out sparks, grit and a puff of dust, rails blast a ring of soot and cracks with a shower of white sparks, plasma spits molten drops and a hiss of steam
+==================
+*/
+void CG_ShotWallDamage( int weapon, vec3_t origin, vec3_t dir ) {
+	vec3_t	start, velocity, side, up;
+	vec3_t	steam = { 0.62f, 0.66f, 0.72f };
+	byte	color[4];
+	int		i, sparks, gravel, puffs;
+	float	speed, spread;
+	qhandle_t	material;
+
+	CG_BlastPlane( dir, side, up );
+	VectorMA( origin, 2, dir, start );
+
+	switch ( weapon ) {
+	case WP_MACHINEGUN:
+		sparks = 2 + rand() % 2;
+		gravel = 1 + rand() % 2;
+		puffs = 1;
+		break;
+	case WP_SHOTGUN:
+		sparks = 1;
+		gravel = ( rand() % 5 < 2 ) ? 1 : 0;
+		puffs = 1;
+		break;
+	case WP_RAILGUN:
+		sparks = 10 + rand() % 5;
+		gravel = 3 + rand() % 3;
+		puffs = 3;
+		CG_ImpactMark( cgs.media.rockSootShader, origin, dir, random() * 360, 1, 1, 1, 1, qfalse, 14 + random() * 4, qfalse );
+		CG_ImpactMark( cgs.media.rockCracksShader, origin, dir, random() * 360, 1, 1, 1, 1, qfalse, 22 + random() * 8, qfalse );
+		break;
+	case WP_PLASMAGUN:
+		sparks = 5 + rand() % 3;
+		gravel = 0;
+		puffs = 2;
+		break;
+	default:
+		return;
+	}
+
+	for ( i = 0 ; i < sparks ; i++ ) {
+		speed = weapon == WP_RAILGUN ? 250 + random() * 300 : 120 + random() * 200;
+		spread = weapon == WP_PLASMAGUN ? 90 : 160;
+		VectorScale( dir, speed, velocity );
+		VectorMA( velocity, crandom() * spread, side, velocity );
+		VectorMA( velocity, crandom() * spread, up, velocity );
+		if ( weapon == WP_RAILGUN ) {
+			color[0] = 200 + rand() % 56;
+			color[1] = 220 + rand() % 36;
+			color[2] = 255;
+		} else if ( weapon == WP_PLASMAGUN ) {
+			// molten drops, dripping as they cool
+			color[0] = 90 + rand() % 60;
+			color[1] = 160 + rand() % 60;
+			color[2] = 255;
+			velocity[2] += 40;
+		} else {
+			color[0] = 255;
+			color[1] = 170 + rand() % 60;
+			color[2] = 60;
+		}
+		color[3] = 255;
+		CG_LaunchDebris( start, velocity, cgs.media.rocketSparkShader,
+			weapon == WP_PLASMAGUN ? 1.2f + random() * 0.8f : 0.6f + random() * 0.6f, color,
+			weapon == WP_PLASMAGUN ? 600 + random() * 500 : 200 + random() * 300,
+			weapon == WP_PLASMAGUN ? 0.2f : 0.5f );
+	}
+
+	if ( gravel ) {
+		CG_MakeRoomForRocks( gravel );
+	}
+	material = gravel ? trap_R_WallMaterial( origin, dir ) : 0;
+	for ( i = 0 ; i < gravel ; i++ ) {
+		VectorScale( dir, 80 + random() * 140, velocity );
+		VectorMA( velocity, crandom() * 90, side, velocity );
+		VectorMA( velocity, crandom() * 90, up, velocity );
+		CG_LaunchRock( start, velocity, -1, 1500 + random() * 1500, material );
+	}
+
+	for ( i = 0 ; i < puffs ; i++ ) {
+		VectorMA( origin, 4 + random() * 4, dir, start );
+		VectorScale( dir, 15 + random() * 25, velocity );
+		VectorMA( velocity, crandom() * 10, side, velocity );
+		if ( weapon == WP_PLASMAGUN ) {
+			CG_Smoke( start, velocity, 5, 22 + random() * 8, steam, 0.35f, 0, 700 + random() * 400, 0 );
+		} else {
+			CG_RockDust( start, velocity, weapon == WP_RAILGUN ? 26 + random() * 12 : 14 + random() * 6,
+				weapon == WP_RAILGUN ? 0.45f : 0.35f, weapon == WP_RAILGUN ? 1600 + random() * 800 : 700 + random() * 500 );
+		}
+	}
+}
