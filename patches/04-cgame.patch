+/*
+===================
+CG_StirRocks
+
+A blast at origin throws the rocks within radius about, the nearest hardest, rubble lying on the floor included
+===================
+*/
+void CG_StirRocks( const vec3_t origin, float radius, float speed ) {
+	localEntity_t	*le;
+	vec3_t			push, velocity;
+	float			d, f;
+	int				i;
+
+	for ( le = cg_activeLocalEntities.next ; le != &cg_activeLocalEntities ; le = le->next ) {
+		if ( !( le->leFlags & LEF_ROCK ) || le->endTime <= cg.time + SINK_TIME ) {
+			continue;
+		}
+		VectorSubtract( le->refEntity.origin, origin, push );
+		d = VectorNormalize( push );
+		if ( d >= radius ) {
+			continue;
+		}
+		if ( d < 1 ) {
+			VectorSet( push, 0, 0, 1 );
+		}
+		f = 1 - d / radius;
+
+		if ( le->pos.trType == TR_STATIONARY ) {
+			VectorClear( velocity );
+		} else {
+			BG_EvaluateTrajectoryDelta( &le->pos, cg.time, velocity );
+		}
+		VectorMA( velocity, speed * f * ( 0.6f + 0.4f * random() ), push, velocity );
+		velocity[0] += crandom() * 60 * f;
+		velocity[1] += crandom() * 60 * f;
+		velocity[2] += 60 + 160 * f;
+
+		le->pos.trType = TR_GRAVITY;
+		VectorCopy( le->refEntity.origin, le->pos.trBase );
+		le->pos.trBase[2] += 1;
+		VectorCopy( velocity, le->pos.trDelta );
+		le->pos.trTime = cg.time;
+
+		le->angles.trType = TR_LINEAR;
+		le->angles.trTime = cg.time;
+		for ( i = 0 ; i < 3 ; i++ ) {
+			le->angles.trBase[i] = random() * 360;
+			le->angles.trDelta[i] = crandom() * 720;
+		}
+
+		// knocks when they land again belong to this blast
+		le->startTime = cg.time;
+	}
+}
