+/*
+=================
+SV_AddHole_f
+
+addhole <x> <y> <z> <nx> <ny> <nz> <radius> [kind]
+
+kind is a holeKind_t, a blast if left out
+=================
+*/
+static void SV_AddHole_f( void ) {
+	const worldHole_t	*hole;
+	vec3_t		origin, normal;
+	int			i, num, cell, carved;
+
+	if ( !com_sv_running->integer ) {
+		return;
+	}
+	if ( Cmd_Argc() != 8 && Cmd_Argc() != 9 ) {
+		Com_Printf( "usage: addhole <x> <y> <z> <nx> <ny> <nz> <radius> [kind], not: %s\n", Cmd_Args() );
+		return;
+	}
+
+	for ( i = 0 ; i < 3 ; i++ ) {
+		origin[i] = atof( Cmd_Argv( 1 + i ) );
+		normal[i] = atof( Cmd_Argv( 4 + i ) );
+	}
+
+	num = CM_AddWorldHole( origin, normal, atof( Cmd_Argv( 7 ) ), Com_Clamp( HOLE_BLAST, HOLE_DRILL, atoi( Cmd_Argv( 8 ) ) ) );
+	if ( num >= 0 && com_developer->integer ) {
+		hole = CM_GetWorldHole( num );
+		carved = 0;
+		for ( cell = 0 ; cell < WORLD_HOLE_GRID * WORLD_HOLE_GRID ; cell++ ) {
+			if ( hole->depth[cell] >= WORLD_HOLE_BIAS + WORLD_HOLE_RIM ) {
+				carved++;
+			}
+		}
+		Com_Printf( "hole %i at (%.1f %.1f %.1f) normal (%.2f %.2f) %i points carved, max depth %.0f\n",
+			num, hole->origin[0], hole->origin[1], hole->origin[2], hole->normal[0], hole->normal[1],
+			carved, hole->maxDepth );
+	}
+}
+
+static void SV_ClearHoles_f( void ) {
+	CM_ClearWorldHoles();
+}
+
+/*
+=================
+SV_HoleTrace_f
+
+holetrace <x1> <y1> <z1> <x2> <y2> <z2> [player]
+=================
+*/
+static void SV_HoleTrace_f( void ) {
+	vec3_t		start, end;
+	vec3_t		mins = { 0, 0, 0 }, maxs = { 0, 0, 0 };
+	trace_t		trace;
+	int			i;
+
+	if ( !com_sv_running->integer || Cmd_Argc() < 7 ) {
+		Com_Printf( "usage: holetrace <x1> <y1> <z1> <x2> <y2> <z2> [player]\n" );
+		return;
+	}
+
+	for ( i = 0 ; i < 3 ; i++ ) {
+		start[i] = atof( Cmd_Argv( 1 + i ) );
+		end[i] = atof( Cmd_Argv( 4 + i ) );
+	}
+	if ( Cmd_Argc() > 7 ) {
+		VectorSet( mins, -15, -15, -24 );
+		VectorSet( maxs, 15, 15, 32 );
+	}
+
+	CM_BoxTrace( &trace, start, end, mins, maxs, 0, MASK_PLAYERSOLID, qfalse );
+	Com_Printf( "fraction %.3f endpos (%.1f %.1f %.1f) normal (%.2f %.2f %.2f) startsolid %i allsolid %i\n",
+		trace.fraction, trace.endpos[0], trace.endpos[1], trace.endpos[2],
+		trace.plane.normal[0], trace.plane.normal[1], trace.plane.normal[2], trace.startsolid, trace.allsolid );
+}
+
