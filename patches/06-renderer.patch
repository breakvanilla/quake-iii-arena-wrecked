+/*
+====================
+RE_RegisterMaterialShader
+
+A plain shader with the texture of a world surface's shader, coloured by vertex, for geometry made up at run time out of the same stuff: the inside of blasted craters. Textures tile every 128 units at the usual texture scale. For models, lit like one: lumps of rock knocked out of the wall, whose texture coordinates run once every 24 units.
+====================
+*/
+qhandle_t RE_RegisterMaterialShader( const char *name, qboolean forModels ) {
+	char		lit[MAX_QPATH];
+	const char	*suffix;
+	shader_t	*sh;
+	image_t		*image;
+	float		scale;
+	int			i, hash;
+
+	suffix = forModels ? "#chunk" : "#material";
+	if ( strlen( name ) + strlen( suffix ) >= sizeof( lit ) ) {
+		return 0;
+	}
+	Com_sprintf( lit, sizeof( lit ), "%s%s", name, suffix );
+
+	hash = generateHashValue( lit, FILE_HASH_SIZE );
+	for ( sh = hashTable[hash] ; sh ; sh = sh->next ) {
+		if ( !Q_stricmp( sh->name, lit ) ) {
+			return sh->index;
+		}
+	}
+
+	// the first stage with a texture of its own, not a lightmap
+	sh = R_FindShader( name, LIGHTMAP_BY_VERTEX, qtrue );
+	if ( sh->defaultShader ) {
+		return 0;
+	}
+	image = NULL;
+	for ( i = 0 ; i < MAX_SHADER_STAGES && sh->stages[i] && sh->stages[i]->active ; i++ ) {
+		image = sh->stages[i]->bundle[0].image[0];
+		if ( image && image != tr.whiteImage && !sh->stages[i]->bundle[0].isLightmap ) {
+			break;
+		}
+		image = NULL;
+	}
+	if ( !image ) {
+		return 0;
+	}
+
+	InitShader( lit, forModels ? LIGHTMAP_NONE : LIGHTMAP_2D );
+	scale = forModels ? 256.0f * 24.0f / 128.0f : 256.0f;
+	stages[0].bundle[0].image[0] = image;
+	stages[0].bundle[0].texMods[0].type = TMOD_SCALE;
+	stages[0].bundle[0].texMods[0].scale[0] = scale / MAX( image->width, 1 );
+	stages[0].bundle[0].texMods[0].scale[1] = scale / MAX( image->height, 1 );
+	stages[0].bundle[0].numTexMods = 1;
+	stages[0].active = qtrue;
+	stages[0].rgbGen = forModels ? CGEN_LIGHTING_DIFFUSE : CGEN_VERTEX;
+	stages[0].alphaGen = AGEN_IDENTITY;
+	stages[0].stateBits = GLS_DEFAULT;
+	shader.cullType = CT_TWO_SIDED;
+
+	return FinishShader()->index;
+}
