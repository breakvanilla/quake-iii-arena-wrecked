+/*
+==================
+CG_RocketWallDamage
+
+Rock chunks, gravel, sparks and dust thrown out of a blasted wall, more falling off the crater's edge a moment later
+==================
+*/
+void CG_RocketWallDamage( vec3_t origin, vec3_t dir ) {
+	localEntity_t	*le;
+	vec3_t	start, velocity, side, up;
+	byte	color[4];
+	float	speed;
+	int		i, count;
+	qhandle_t	material;
+
+	// the rocks are of the wall's own stuff
+	material = trap_R_WallMaterial( origin, dir );
+
+	VectorMA( origin, 6, dir, start );
+	CG_RockSpray( start, dir, 12 + rand() % 6, 26 + rand() % 12, 380, material );
+
+	VectorMA( origin, 4, dir, start );
+	count = 8 + rand() % 5;
+	for ( i = 0 ; i < count ; i++ ) {
+		speed = 250 + random() * 350;
+		VectorScale( dir, speed, velocity );
+		velocity[0] += crandom() * 260;
+		velocity[1] += crandom() * 260;
+		velocity[2] += 60 + crandom() * 260;
+
+		color[0] = 255;
+		color[1] = 140 + random() * 60;
+		color[2] = 40;
+		color[3] = 255;
+
+		CG_LaunchDebris( start, velocity, cgs.media.rocketSparkShader,
+			1.0f + random(), color, 500 + random() * 600, 0.5f );
+	}
+
+	// a thick cloud of dust that rolls out and hangs in the air
+	CG_BlastPlane( dir, side, up );
+	for ( i = 0 ; i < 10 ; i++ ) {
+		VectorMA( origin, 6 + random() * 18, dir, start );
+		VectorMA( start, crandom() * 20, side, start );
+		VectorMA( start, crandom() * 20, up, start );
+
+		VectorScale( dir, 30 + random() * 60, velocity );
+		VectorMA( velocity, crandom() * 40, side, velocity );
+		VectorMA( velocity, crandom() * 30, up, velocity );
+		velocity[2] -= random() * 12;
+
+		CG_RockDust( start, velocity, 32 + random() * 28, 0.5f + random() * 0.15f, 800 + random() * 400 );
+	}
+
+	// the rock cracking and breaking up, under the bang of the rocket
+	trap_S_StartSound( origin, ENTITYNUM_WORLD, CHAN_AUTO, cgs.media.rockBlastSound );
+
+	// soot blown out across the surface, and cracks running out from the crater
+	CG_ImpactMark( cgs.media.rockSootShader, origin, dir, random() * 360, 1, 1, 1, 1, qfalse, 60 + random() * 16, qfalse );
+	CG_ImpactMark( cgs.media.rockCracksShader, origin, dir, random() * 360, 1, 1, 1, 1, qfalse, 76 + random() * 24, qfalse );
+
+	CG_CraterEmbers( origin, dir );
+
+	// smoke keeps pouring out of the crater for a while
+	le = CG_AllocLocalEntity();
+	le->leType = LE_SMOKE_COLUMN;
+	le->startTime = cg.time + 150;
+	le->endTime = le->startTime + 1000;
+	le->lifeRate = 1.0f / ( le->endTime - le->startTime );
+	le->fadeInTime = le->startTime;
+	CG_CraterFloor( origin, dir, 0, 0, le->pos.trBase );
+	VectorCopy( dir, le->pos.trDelta );
+
+	// the edge gives way a moment later, twice
+	for ( i = 0 ; i < 2 ; i++ ) {
+		le = CG_AllocLocalEntity();
+		le->leType = LE_CRUMBLE;
+		le->startTime = cg.time + ( i ? 1200 + random() * 500 : 450 + random() * 300 );
+		le->endTime = le->startTime + 100;
+		le->radius = 22 + random() * 10;
+		le->refEntity.customShader = material;
+		VectorCopy( origin, le->pos.trBase );
+		VectorCopy( dir, le->pos.trDelta );
+	}
+}
+
+/*
+==================
+CG_AddCrumble
+
+Rocks breaking off the edge of a fresh crater and trickling dust, piling up at the foot of the wall
+==================
+*/
+void CG_AddCrumble( localEntity_t *le ) {
+	vec3_t	origin, dir, side, up, start, velocity;
+	float	ang, r;
+	int		i, count, size;
+	qhandle_t	material;
+
+	if ( cg.time < le->startTime ) {
+		return;
+	}
+	VectorCopy( le->pos.trBase, origin );
+	VectorCopy( le->pos.trDelta, dir );
+	r = le->radius;
+	material = le->refEntity.customShader;
+	CG_FreeLocalEntity( le );
+
+	CG_BlastPlane( dir, side, up );
+	count = 6 + rand() % 4;
+	CG_MakeRoomForRocks( count );
+	for ( i = 0 ; i < count ; i++ ) {
+		// on walls the rocks come off the top of the crater
+		if ( fabs( dir[2] ) < 0.7f ) {
+			ang = M_PI * ( 0.1f + 0.8f * random() );
+		} else {
+			ang = 2 * M_PI * random();
+		}
+		VectorMA( origin, 3, dir, start );
+		VectorMA( start, r * cos( ang ), side, start );
+		VectorMA( start, r * sin( ang ), up, start );
+
+		VectorScale( dir, 15 + random() * 45, velocity );
+		VectorMA( velocity, -r * cos( ang ) * 0.8f, side, velocity );
+		VectorMA( velocity, -r * sin( ang ) * 0.8f, up, velocity );
+		size = ( rand() % 2 ) ? -1 : rand() % 4;
+		CG_LaunchRock( start, velocity, size, CG_RubbleLife( size ), material );
+	}
+
+	for ( i = 0 ; i < 4 ; i++ ) {
+		ang = 2 * M_PI * random();
+		VectorMA( origin, 4 + random() * 6, dir, start );
+		VectorMA( start, r * cos( ang ), side, start );
+		VectorMA( start, r * sin( ang ), up, start );
+		VectorSet( velocity, crandom() * 6, crandom() * 6, -12 - random() * 18 );
+		CG_RockDust( start, velocity, 14 + random() * 12, 0.35f, 900 + random() * 400 );
+	}
+}
