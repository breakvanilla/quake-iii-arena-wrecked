@@ -437,6 +437,13 @@ void G_MissileImpact( gentity_t *ent, trace_t *trace ) {
 		}
 	}
 
+	// rockets blast craters into walls, plasma melts pits
+	if ( ent->s.weapon == WP_ROCKET_LAUNCHER ) {
+		G_WorldHole( trace, g_destruction.value, HOLE_KIND_BLAST );
+	} else if ( ent->s.weapon == WP_PLASMAGUN ) {
+		G_WorldHole( trace, HOLE_RADIUS_PLASMA, HOLE_KIND_MELT );
+	}
+
 	trap_LinkEntity( ent );
 }
 
