+/*
+==================
+CG_RockSound
+
+A stone knocking on stone. A blast throws out dozens of them at once, so no more than a few play close together, and never the same one twice in a row.
+==================
+*/
+void CG_RockSound( vec3_t origin ) {
+	static int	recent[3];
+	static int	last;
+	int			i, oldest, pick;
+
+	oldest = 0;
+	for ( i = 1 ; i < 3 ; i++ ) {
+		if ( recent[i] < recent[oldest] ) {
+			oldest = i;
+		}
+	}
+	if ( recent[oldest] > cg.time - 150 && recent[oldest] <= cg.time ) {
+		return;
+	}
+	recent[oldest] = cg.time;
+
+	pick = rand() % ( NUM_ROCK_SOUNDS - 1 );
+	if ( pick >= last ) {
+		pick++;
+	}
+	last = pick;
+	trap_S_StartSound( origin, ENTITYNUM_WORLD, CHAN_AUTO, cgs.media.rockSounds[pick] );
+}
+
+/*
+==================
+CG_LaunchRock
+
+A tumbling lump of rock that bounces around and settles on the floor. size is the chunk model index, or -1 for gravel. material is the wall it came out of, see trap_R_WallMaterial, or 0 for plain rock.
+==================
+*/
+static void CG_LaunchRock( const vec3_t origin, const vec3_t velocity, int size, int life, qhandle_t material ) {
+	localEntity_t	*le;
+	refEntity_t		*re;
+	int				i;
+
+	le = CG_AllocLocalEntity();
+	re = &le->refEntity;
+
+	le->leType = LE_FRAGMENT;
+	le->leFlags = LEF_TUMBLE | LEF_ROCK;
+	le->startTime = cg.time;
+	le->endTime = cg.time + life;
+	le->radius = size;
+
+	VectorCopy( origin, re->origin );
+	if ( size < 0 ) {
+		re->hModel = cgs.media.rocketGravelModels[rand() % NUM_ROCKET_GRAVEL];
+	} else {
+		re->hModel = cgs.media.rocketChunkModels[size];
+	}
+	re->customShader = material;
+	// dozens of rocks can be lying around; casting shadows they cost more than they show
+	re->renderfx = RF_NOSHADOW;
+
+	le->pos.trType = TR_GRAVITY;
+	VectorCopy( origin, le->pos.trBase );
+	VectorCopy( velocity, le->pos.trDelta );
+	le->pos.trTime = cg.time;
+
+	le->angles.trType = TR_LINEAR;
+	le->angles.trTime = cg.time;
+	for ( i = 0 ; i < 3 ; i++ ) {
+		le->angles.trBase[i] = random() * 360;
+		le->angles.trDelta[i] = crandom() * ( size < 0 ? 1080 : 720 );
+	}
+	AnglesToAxis( le->angles.trBase, re->axis );
+
+	le->bounceFactor = 0.3f + random() * 0.2f;
+	le->leMarkType = LEMT_NONE;
+	le->leBounceSoundType = size >= 2 ? LEBS_ROCK : LEBS_NONE;
+	if ( size >= 3 ) {
+		le->leFlags |= LEF_SHATTER;
+	}
+}
+
+/*
+==================
+CG_RubbleLife
+
+How long a rock lies about before it sinks away: chunks long enough to leave the floor strewn with rubble, the biggest longest, and gravel only briefly
+==================
+*/
+static int CG_RubbleLife( int size ) {
+	if ( size < 0 ) {
+		return 3000 + random() * 2500;
+	}
+	return 1000 * MAX( cg_rubbleTime.value, 2 ) * ( 0.75f + 0.5f * random() ) * ( 0.8f + 0.1f * size );
+}
+
+/*
+==================
+CG_Smoke
+
+A thick puff of smoke or dust. It slows down in the air, rises, swirls and spreads out under ceilings, lit by the level around it and, while it is young, glowing from the fire it came out of.
+==================
+*/
+localEntity_t *CG_Smoke( const vec3_t origin, const vec3_t velocity, float radius, float endRadius,
+	const vec3_t color, float alpha, int delay, int duration, float fireGlow ) {
+	localEntity_t	*le;
+	trace_t			tr;
+	vec3_t			end;
+
+	le = CG_AllocLocalEntity();
+	le->leType = LE_SMOKE;
+	le->startTime = cg.time + delay;
+	le->endTime = le->startTime + duration;
+	le->lifeRate = 1.0f / duration;
+	VectorCopy( origin, le->pos.trBase );
+	VectorCopy( velocity, le->pos.trDelta );
+	le->radius = radius;
+	le->endRadius = endRadius;
+	VectorCopy( color, le->color );
+	le->color[3] = alpha;
+	le->light = fireGlow;
+
+	le->angles.trBase[0] = random() * 360;
+	le->angles.trDelta[0] = crandom() * 12;
+	le->angles.trBase[2] = random() * 2 * M_PI;		// where it is in its swirl
+
+	// the ceiling it will spread out under
+	VectorCopy( origin, end );
+	end[2] += 1024;
+	CG_Trace( &tr, origin, NULL, NULL, end, -1, CONTENTS_SOLID );
+	le->angles.trBase[1] = tr.endpos[2];
+
+	le->refEntity.reType = RT_SPRITE;
+	le->refEntity.customShader = cgs.media.thickSmokeShaders[rand() % NUM_SMOKE_SHADERS];
+	return le;
+}
+
+void CG_AddSmoke( localEntity_t *le ) {
+	refEntity_t	*re;
+	vec3_t		ambient, directed, lightDir, flat;
+	float		dt, t, c, r, a, lit, glow, ceiling;
+	int			i;
+
+	if ( cg.time < le->startTime ) {
+		return;
+	}
+	re = &le->refEntity;
+	dt = MIN( cg.frametime * 0.001f, 0.05f );
+	t = ( cg.time - le->startTime ) * 0.001f;
+	c = ( cg.time - le->startTime ) * le->lifeRate;
+	r = le->radius + ( le->endRadius - le->radius ) * ( 1 - ( 1 - c ) * ( 1 - c ) );
+
+	// the air slows it down, its heat lifts it and it swirls about
+	VectorScale( le->pos.trDelta, 1 - MIN( 1.6f * dt, 0.5f ), le->pos.trDelta );
+	le->pos.trDelta[2] += 34 * dt;
+	le->pos.trDelta[0] += 14 * dt * sin( t * 1.3f + le->angles.trBase[2] );
+	le->pos.trDelta[1] += 14 * dt * cos( t * 1.1f + le->angles.trBase[2] * 1.7f );
+	VectorMA( le->pos.trBase, dt, le->pos.trDelta, le->pos.trBase );
+
+	// under a ceiling it rolls out sideways instead
+	ceiling = le->angles.trBase[1] - r * 0.35f;
+	if ( le->pos.trBase[2] > ceiling ) {
+		le->pos.trBase[2] = ceiling;
+		if ( le->pos.trDelta[2] > 0 ) {
+			VectorSet( flat, le->pos.trDelta[0], le->pos.trDelta[1], 0 );
+			if ( VectorNormalize( flat ) < 1 ) {
+				VectorSet( flat, cos( le->angles.trBase[2] ), sin( le->angles.trBase[2] ), 0 );
+			}
+			VectorMA( le->pos.trDelta, le->pos.trDelta[2] * 0.7f, flat, le->pos.trDelta );
+			le->pos.trDelta[2] = 0;
+		}
+	}
+
+	// lit by the level, mostly from above
+	if ( trap_R_LightForPoint( le->pos.trBase, ambient, directed, lightDir ) ) {
+		lit = 0.6f + 0.4f * MAX( lightDir[2], 0 );
+		for ( i = 0 ; i < 3 ; i++ ) {
+			ambient[i] = Com_Clamp( 0.12f, 1.3f, ( ambient[i] + directed[i] * lit * 0.6f ) / 200.0f );
+		}
+	} else {
+		VectorSet( ambient, 0.8f, 0.8f, 0.8f );
+	}
+
+	// and by the fire for a moment
+	glow = t < 0.4f ? le->light * ( 1 - t / 0.4f ) * ( 1 - t / 0.4f ) : 0;
+
+	a = le->color[3] * MIN( t / 0.12f, 1 ) * ( 1 - c ) * ( 1 - c );
+	re->shaderRGBA[0] = 255 * Com_Clamp( 0, 1, le->color[0] * ambient[0] + glow );
+	re->shaderRGBA[1] = 255 * Com_Clamp( 0, 1, le->color[1] * ambient[1] + glow * 0.45f );
+	re->shaderRGBA[2] = 255 * Com_Clamp( 0, 1, le->color[2] * ambient[2] + glow * 0.12f );
+	re->shaderRGBA[3] = 255 * Com_Clamp( 0, 1, a );
+
+	VectorCopy( le->pos.trBase, re->origin );
+	re->radius = r;
+	re->rotation = le->angles.trBase[0] + le->angles.trDelta[0] * t;
+	trap_R_AddRefEntityToScene( re );
+}
+
+static void CG_RockDust( const vec3_t origin, const vec3_t velocity, float radius, float alpha, int duration ) {
+	vec3_t	color = { 0.5f, 0.46f, 0.4f };
+
+	CG_Smoke( origin, velocity, radius * 0.45f, radius * 1.3f, color, alpha, 0, duration, 0 );
+}
+
+// the plane of a blasted surface: side runs along it, up is as near world up as it gets
+static void CG_BlastPlane( const vec3_t dir, vec3_t side, vec3_t up ) {
+	vec3_t	worldUp = { 0, 0, 1 };
+
+	if ( fabs( dir[2] ) < 0.7f ) {
+		CrossProduct( dir, worldUp, side );
+		VectorNormalize( side );
+	} else {
+		PerpendicularVector( side, dir );
+	}
+	CrossProduct( side, dir, up );
+}
+
+void CG_FragmentBounceSound( localEntity_t *le, trace_t *trace );
+void CG_ReflectVelocity( localEntity_t *le, trace_t *trace );
+
+/*
+==================
+CG_ShatterChunk
+
+A big rock hitting something: it breaks into smaller ones if it hits hard, otherwise it just bounces
+==================
+*/
+void CG_ShatterChunk( localEntity_t *le, const trace_t *trace ) {
+	trace_t	tr;
+	vec3_t	velocity, bounce, start, v;
+	float	speed, dot;
+	int		hitTime, size, life, i, count;
+	qhandle_t	material;
+
+	tr = *trace;
+	hitTime = cg.time - cg.frametime + cg.frametime * tr.fraction;
+	BG_EvaluateTrajectoryDelta( &le->pos, hitTime, velocity );
+	speed = VectorLength( velocity );
+	le->leFlags &= ~LEF_SHATTER;
+	if ( speed < 220 || tr.allsolid ) {
+		CG_FragmentBounceSound( le, &tr );
+		CG_ReflectVelocity( le, &tr );
+		trap_R_AddRefEntityToScene( &le->refEntity );
+		return;
+	}
+
+	// making room for the pieces must not clear away this one
+	le->leFlags &= ~LEF_ROCK;
+	count = 3 + rand() % 3;
+	CG_MakeRoomForRocks( count );
+
+	size = le->radius;
+	life = le->endTime - cg.time;
+	dot = DotProduct( velocity, tr.plane.normal );
+	VectorMA( velocity, -2 * dot, tr.plane.normal, bounce );
+	VectorScale( bounce, 0.45f, bounce );
+	VectorMA( tr.endpos, 2, tr.plane.normal, start );
+	if ( cg.time - le->startTime < ROCK_SOUND_TIME ) {
+		CG_RockSound( tr.endpos );
+	}
+
+	// free it first: spawning the pieces may need its slot
+	material = le->refEntity.customShader;
+	CG_FreeLocalEntity( le );
+
+	for ( i = 0 ; i < count ; i++ ) {
+		VectorCopy( bounce, v );
+		v[0] += crandom() * 140;
+		v[1] += crandom() * 140;
+		v[2] += crandom() * 80;
+		VectorMA( v, 40 + random() * 120, tr.plane.normal, v );
+		CG_LaunchRock( start, v, i == 0 ? size - 2 : ( i == 1 ? size - 3 : -1 ), i < 2 ? life : CG_RubbleLife( -1 ), material );
+	}
+
+	VectorScale( tr.plane.normal, 15, v );
+	CG_RockDust( start, v, 12 + random() * 8, 0.4f, 900 + random() * 400 );
+}
+
+/*
+==================
+CG_RockSpray
+
+A cone of rocks thrown out from origin along dir
+==================
+*/
+static void CG_RockSpray( const vec3_t origin, const vec3_t dir, int chunks, int gravel, float speed, qhandle_t material ) {
+	vec3_t	velocity;
+	int		i, size;
+
+	CG_MakeRoomForRocks( chunks );
+	for ( i = 0 ; i < chunks ; i++ ) {
+		VectorScale( dir, speed * ( 0.4f + random() * 0.8f ), velocity );
+		velocity[0] += crandom() * 220;
+		velocity[1] += crandom() * 220;
+		velocity[2] += 120 + crandom() * 200;
+
+		// mostly small chunks, now and then a big one
+		size = (int)( random() * random() * NUM_ROCKET_CHUNKS );
+		CG_LaunchRock( origin, velocity, size, CG_RubbleLife( size ), material );
+	}
+
+	CG_MakeRoomForRocks( gravel );
+	for ( i = 0 ; i < gravel ; i++ ) {
+		VectorScale( dir, speed * ( 0.6f + random() * 1.0f ), velocity );
+		velocity[0] += crandom() * 320;
+		velocity[1] += crandom() * 320;
+		velocity[2] += 150 + crandom() * 260;
+		CG_LaunchRock( origin, velocity, -1, CG_RubbleLife( -1 ), material );
+	}
+}
+
+/*
+==================
+CG_CraterFloor
+
+Where the crater blasted at origin is, a and b units across the surface from its middle, found by tracing in from in front of the wall. Returns qfalse if nothing solid is there.
+==================
+*/
+static qboolean CG_CraterFloor( const vec3_t origin, const vec3_t dir, float a, float b, vec3_t spot ) {
+	trace_t	tr;
+	vec3_t	side, up, start, end;
+
+	CG_BlastPlane( dir, side, up );
+	VectorMA( origin, 8, dir, start );
+	VectorMA( start, a, side, start );
+	VectorMA( start, b, up, start );
+	VectorMA( start, -80, dir, end );
+	CG_Trace( &tr, start, NULL, NULL, end, -1, CONTENTS_SOLID );
+	if ( tr.startsolid || tr.fraction == 1.0f ) {
+		VectorCopy( origin, spot );
+		return qfalse;
+	}
+	VectorMA( tr.endpos, 1, tr.plane.normal, spot );
+	return qtrue;
+}
+
+/*
+==================
+CG_CraterEmbers
+
+Bits of burning rock left glowing on the floor of a fresh crater
+==================
+*/
+static void CG_CraterEmbers( const vec3_t origin, const vec3_t dir ) {
+	localEntity_t	*le;
+	vec3_t			spot;
+	int				i, count;
+
+	count = 12 + rand() % 7;
+	for ( i = 0 ; i < count ; i++ ) {
+		if ( !CG_CraterFloor( origin, dir, crandom() * 20, crandom() * 20, spot ) ) {
+			continue;
+		}
+		le = CG_AllocLocalEntity();
+		le->leType = LE_EMBER;
+		le->startTime = cg.time;
+		le->endTime = cg.time + 3500 + random() * 5000;
+		le->lifeRate = 1.0f / ( le->endTime - le->startTime );
+		le->radius = 1.2f + random() * 1.6f;
+		le->color[0] = 0.7f + random() * 0.5f;		// how hot it starts
+		le->color[1] = 0.5f + random();				// how fast it flickers
+		le->color[2] = random() * 2 * M_PI;
+		VectorCopy( spot, le->refEntity.origin );
+		le->refEntity.reType = RT_SPRITE;
+		le->refEntity.customShader = cgs.media.emberShader;
+		le->refEntity.rotation = random() * 360;
+	}
+}
+
+void CG_AddEmber( localEntity_t *le ) {
+	refEntity_t	*re;
+	float		c, heat;
+
+	re = &le->refEntity;
+	c = ( cg.time - le->startTime ) * le->lifeRate;
+	heat = le->color[0] * ( 1 - c ) * ( 0.7f + 0.3f * sin( cg.time * 0.012f * le->color[1] + le->color[2] ) );
+
+	re->radius = le->radius * ( 0.5f + 0.5f * ( 1 - c ) );
+	re->shaderRGBA[0] = 255 * Com_Clamp( 0, 1, heat * 1.4f );
+	re->shaderRGBA[1] = 255 * Com_Clamp( 0, 1, heat * heat * 0.7f );
+	re->shaderRGBA[2] = 255 * Com_Clamp( 0, 1, heat * heat * heat * heat * 0.3f );
+	re->shaderRGBA[3] = 255;
+	trap_R_AddRefEntityToScene( re );
+}
+
+void CG_AddSmokeColumn( localEntity_t *le ) {
+	vec3_t	side, up, start, velocity, color;
+	float	c, shade;
+
+	// fadeInTime is when the next puff comes out
+	CG_BlastPlane( le->pos.trDelta, side, up );
+	while ( cg.time >= le->fadeInTime && le->fadeInTime < le->endTime ) {
+		c = ( le->fadeInTime - le->startTime ) * le->lifeRate;
+
+		VectorMA( le->pos.trBase, 2 + random() * 6, le->pos.trDelta, start );
+		VectorMA( start, crandom() * 6, side, start );
+		VectorMA( start, crandom() * 6, up, start );
+
+		VectorScale( le->pos.trDelta, 25 + random() * 25, velocity );
+		VectorMA( velocity, crandom() * 8, side, velocity );
+		velocity[2] += 15 + random() * 20;
+
+		shade = 0.2f + 0.1f * random();
+		VectorSet( color, shade, shade * 0.96f, shade * 0.92f );
+		CG_Smoke( start, velocity, 12 + random() * 6, 52 + random() * 28 + 30 * c, color,
+			0.2f + 0.6f * ( 1 - c ), le->fadeInTime - cg.time, 900 + random() * 400, 0.35f * ( 1 - c ) );
+
+		// thinning out as it burns down
+		le->fadeInTime += 60 + 120 * c;
+	}
+}
+
+// a puff of fire thrown out of a blast, see CG_AddFireball
+static localEntity_t *CG_Flame( const vec3_t origin, const vec3_t velocity, float radius, float endRadius,
+	int delay, int duration, qhandle_t shader ) {
+	localEntity_t	*le;
+
+	le = CG_AllocLocalEntity();
+	le->leType = LE_FIREBALL;
+	le->startTime = cg.time + delay;
+	le->endTime = le->startTime + duration;
+	le->lifeRate = 1.0f / duration;
+	VectorCopy( origin, le->pos.trBase );
+	VectorCopy( velocity, le->pos.trDelta );
+	le->radius = radius;
+	le->endRadius = endRadius;
+	le->color[0] = 1;		// heat
+	le->color[3] = 1;		// brightness
+	le->angles.trBase[0] = random() * 360;
+	le->angles.trDelta[0] = crandom() * 90;
+	le->refEntity.reType = RT_SPRITE;
+	le->refEntity.customShader = shader;
+	return le;
+}
+
+/*
+==================
+CG_RocketFireball
+
+A rolling ball of fire around a rocket blast: a white hot flash that lights up the room and jolts the view, flames bursting out and slowing down as they cool, a shock ring across the surface it hit, rubble lying nearby thrown about and dark smoke left hanging where it was
+==================
+*/
+void CG_RocketFireball( vec3_t origin, vec3_t dir, qboolean onSurface ) {
+	localEntity_t	*le;
+	vec3_t			side, up, start, v, color;
+	float			d;
+	int				i, count;
+
+	CG_BlastPlane( dir, side, up );
+
+	// white hot flash
+	VectorMA( origin, 10, dir, start );
+	VectorClear( v );
+	le = CG_Flame( start, v, 20, 72, 0, 220, cgs.media.emberShader );
+	le->color[3] = 1.6f;
+
+	le = CG_AllocLocalEntity();
+	le->leType = LE_FLASH;
+	le->startTime = cg.time;
+	le->endTime = cg.time + 400;
+	le->light = 750;
+	VectorMA( origin, 24, dir, le->pos.trBase );
+
+	CG_ShakeView( origin, 1 );
+	CG_StirRocks( origin, 170, 520 );
+
+	// flames bursting out, away from the surface
+	count = 12 + rand() % 5;
+	for ( i = 0 ; i < count ; i++ ) {
+		v[0] = crandom();
+		v[1] = crandom();
+		v[2] = crandom();
+		VectorNormalize( v );
+		if ( onSurface ) {
+			d = DotProduct( v, dir );
+			if ( d < 0 ) {
+				VectorMA( v, -2 * d, dir, v );
+			}
+			VectorMA( v, 0.35f, dir, v );
+			VectorNormalize( v );
+		}
+		VectorMA( origin, 6, dir, start );
+		VectorScale( v, 140 + random() * 280, v );
+		le = CG_Flame( start, v, 8 + random() * 6, 24 + random() * 20, rand() % 50, 420 + random() * 480,
+			cgs.media.fireballShader );
+		le->color[0] = 0.8f;
+		le->color[3] = 0.45f + 0.25f * random();
+	}
+
+	// a shock ring racing out across the surface
+	if ( onSurface ) {
+		le = CG_AllocLocalEntity();
+		le->leType = LE_SHOCKWAVE;
+		le->startTime = cg.time;
+		le->endTime = cg.time + 320;
+		le->lifeRate = 1.0f / ( le->endTime - le->startTime );
+		VectorMA( origin, 1.5f, dir, le->pos.trBase );
+		VectorCopy( dir, le->pos.trDelta );
+		le->radius = 130;
+	}
+
+	// thick smoke left rolling where the fire was, lit by it from inside
+	for ( i = 0 ; i < 10 ; i++ ) {
+		VectorMA( origin, 14 + random() * 18, dir, start );
+		VectorMA( start, crandom() * 18, side, start );
+		VectorMA( start, crandom() * 18, up, start );
+		VectorScale( dir, 20 + random() * 40, v );
+		VectorMA( v, crandom() * 45, side, v );
+		VectorMA( v, crandom() * 30, up, v );
+		d = 0.18f + 0.1f * random();
+		VectorSet( color, d, d * 0.97f, d * 0.94f );
+		CG_Smoke( start, v, 22 + random() * 10, 70 + random() * 30, color, 0.8f,
+			60 + rand() % 100, 900 + random() * 400, 0.9f );
+	}
+}
+
+// the room lit up for a moment, white then fading through orange
+void CG_AddFlash( localEntity_t *le ) {
+	float	t, k;
+
+	t = cg.time - le->startTime;
+	k = t < 40 ? 1 : 1 / ( 1 + ( t - 40 ) * ( t - 40 ) / 3600.0f );
+	trap_R_AddLightToScene( le->pos.trBase, le->light * ( 0.4f + 0.6f * k ), k * 1.6f, k * ( 0.6f + 0.6f * k ), k * k * 0.9f );
+}
+
+void CG_AddFireball( localEntity_t *le ) {
+	refEntity_t	*re;
+	float		t, c, heat, fade;
+
+	if ( cg.time < le->startTime ) {
+		return;
+	}
+	re = &le->refEntity;
+	t = ( cg.time - le->startTime ) * 0.001f;
+	c = ( cg.time - le->startTime ) * le->lifeRate;
+
+	// thrown out fast, slowing down in the air as it grows
+	VectorMA( le->pos.trBase, t / ( 1 + 6 * t ), le->pos.trDelta, re->origin );
+	re->radius = le->radius + ( le->endRadius - le->radius ) * 9 * t / ( 1 + 9 * t );
+	re->rotation = le->angles.trBase[0] + le->angles.trDelta[0] * t;
+
+	// white, then yellow, orange and a dull red as it burns out
+	heat = le->color[0] * ( 1 - c );
+	fade = le->color[3] * ( 1 - c ) * ( 1 - c );
+	re->shaderRGBA[0] = 255 * Com_Clamp( 0, 1, fade );
+	re->shaderRGBA[1] = 255 * Com_Clamp( 0, 1, fade * ( 0.22f + 0.6f * heat ) );
+	re->shaderRGBA[2] = 255 * Com_Clamp( 0, 1, fade * ( 0.03f + 0.55f * heat * heat * heat ) );
+	re->shaderRGBA[3] = 255;
+	trap_R_AddRefEntityToScene( re );
+}
+
+void CG_AddShockwave( localEntity_t *le ) {
+	polyVert_t	verts[4];
+	vec3_t		side, up;
+	float		c, r, a;
+	int			i;
+
+	c = ( cg.time - le->startTime ) * le->lifeRate;
+	r = le->radius * ( 1 - ( 1 - c ) * ( 1 - c ) * ( 1 - c ) ) + 8;
+	a = 0.55f * ( 1 - c ) * sqrt( 1 - c );
+
+	CG_BlastPlane( le->pos.trDelta, side, up );
+	for ( i = 0 ; i < 4 ; i++ ) {
+		VectorMA( le->pos.trBase, ( i == 0 || i == 3 ) ? -r : r, side, verts[i].xyz );
+		VectorMA( verts[i].xyz, ( i < 2 ) ? -r : r, up, verts[i].xyz );
+		verts[i].st[0] = ( i == 0 || i == 3 ) ? 0 : 1;
+		verts[i].st[1] = ( i < 2 ) ? 0 : 1;
+		verts[i].modulate[0] = 255 * a;
+		verts[i].modulate[1] = 210 * a;
+		verts[i].modulate[2] = 160 * a;
+		verts[i].modulate[3] = 255;
+	}
+	trap_R_AddPolyToScene( cgs.media.shockRingShader, 4, verts );
+}
