+/*
+===============
+CG_ShakeView
+
+A blast at origin jolts the view, harder the closer it is. Shakes do not add up: a second blast only makes it as hard again as it would be on its own.
+===============
+*/
+void CG_ShakeView( const vec3_t origin, float amount ) {
+	float	d, left;
+	int		i;
+
+	d = Distance( origin, cg.predictedPlayerState.origin );
+	if ( d >= 700 ) {
+		return;
+	}
+	amount *= ( 1 - d / 700 ) * ( 1 - d / 700 ) * cg_shake.value;
+
+	left = cg.time - cg.shakeTime < SHAKE_TIME ? cg.shakeAmount * ( 1 - (float)( cg.time - cg.shakeTime ) / SHAKE_TIME ) : 0;
+	if ( amount <= left ) {
+		return;
+	}
+	cg.shakeTime = cg.time;
+	cg.shakeAmount = amount;
+	for ( i = 0 ; i < 3 ; i++ ) {
+		cg.shakePhase[i] = random() * 2 * M_PI;
+	}
+}
+
+/*
+===============
+CG_AddShake
+
+Jolts the view angles, not where the player aims: a quick, uneven shudder that dies away
+===============
+*/
+static void CG_AddShake( void ) {
+	float	t, k;
+	int		i;
+
+	t = cg.time - cg.shakeTime;
+	if ( t < 0 || t >= SHAKE_TIME || cg.shakeAmount <= 0 ) {
+		return;
+	}
+	k = 1 - t / SHAKE_TIME;
+	k = cg.shakeAmount * k * k;
+	for ( i = 0 ; i < 3 ; i++ ) {
+		cg.refdefViewAngles[i] += k * ( i == ROLL ? 0.75f : ( i == PITCH ? 1.5f : 1.0f ) )
+			* ( 0.65f * sin( t * 0.075f + cg.shakePhase[i] ) + 0.35f * sin( t * 0.131f + cg.shakePhase[( i + 1 ) % 3] * 2 ) );
+	}
+}
+
