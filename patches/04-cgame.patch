+	for ( le = cg_activeLocalEntities.next ; le != &cg_activeLocalEntities ; le = le->next ) {
+		if ( ( le->leFlags & LEF_ROCK ) && le->endTime > cg.time + SINK_TIME ) {
+			rocks++;
+		}
+	}
+
+	// the newest are at the front of the list, so start from the back
+	for ( pass = 0 ; pass < 2 ; pass++ ) {
+		for ( le = cg_activeLocalEntities.prev ; le != &cg_activeLocalEntities && rocks + count > MAX_ROCK_DEBRIS ; le = le->prev ) {
+			if ( !( le->leFlags & LEF_ROCK ) || le->endTime <= cg.time + SINK_TIME || ( pass == 0 && le->radius >= 0 ) ) {
+				continue;
+			}
+			le->endTime = le->pos.trType == TR_STATIONARY ? cg.time + SINK_TIME : cg.time;
