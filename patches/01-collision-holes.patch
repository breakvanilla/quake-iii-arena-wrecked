+#include "cm_local.h"
+
+/*
+===============================================================================
+
+WORLD HOLES
+
+Craters blasted into walls at runtime. Each hole is a grid of points on one wall plane, each carved to its own depth behind it, with the depth interpolated in between. Only brushes recorded for the hole are carved, and for them traces, position tests and point contents treat the crater as empty.
+
+===============================================================================
+*/
+
+#define	HOLE_CELL				WORLD_HOLE_CELL
+#define	HOLE_GRID				WORLD_HOLE_GRID
+#define	HOLE_HALF				( HOLE_GRID * HOLE_CELL / 2 )
+#define	HOLE_SURFACE_SEARCH		8		// how far behind the impact point the struck surface may be
+#define	HOLE_MAX_THICKNESS		128
+#define	HOLE_CRATER_DEPTH		0.75f	// deepest a crater gets, times the blast radius
+#define	HOLE_CRATER_GROWTH		0.6f	// how much wider a crater gets once it is that deep
+#define	HOLE_PIT_DEPTH			0.6f	// and the same for molten pits
+#define	HOLE_PIT_GROWTH			0.3f
+#define	HOLE_CHIP_DEPTH			3		// deepest bullets wear a pit, times their radius
+#define	HOLE_BORE_DEPTH			4		// deepest a rail bore goes, times its radius
+#define	HOLE_WALL_LEFT			4		// rock always left at the back of a wall
+#define	HOLE_CLIP_REACH			32		// clip brushes in front of the wall that also get cut
+#define	HOLE_CARVE_CONTENTS		( CONTENTS_SOLID | CONTENTS_PLAYERCLIP | CONTENTS_MONSTERCLIP | CONTENTS_BOTCLIP )
+#define	HOLE_MAX_LEAFS			1024
+#define	HOLE_TRACE_STEP			2		// units between samples when a trace runs through a crater
+#define	HOLE_EDGE_SLOPE			4		// how fast the depth falls away outside a crater's edge
+
+static int	holeSerial;
+
+static void CM_HoleLocal( const worldHole_t *hole, const vec3_t p, float *a, float *b, float *h ) {
+	vec3_t	delta;
+
+	VectorSubtract( p, hole->origin, delta );
+	*a = DotProduct( delta, hole->axis );
+	*b = DotProduct( delta, hole->up );
+	*h = DotProduct( delta, hole->normal );
+}
+
+static void CM_HolePoint( const worldHole_t *hole, float a, float b, float h, vec3_t p ) {
+	VectorMA( hole->origin, a, hole->axis, p );
+	VectorMA( p, b, hole->up, p );
+	VectorMA( p, h, hole->normal, p );
+}
+
+/*
+================
+CM_HoleDepthAt
+
+Carved depth at grid position (x,y), interpolated over the same triangles the renderer uses.
+================
+*/
+static float CM_HoleDepthAt( const cHole_t *hole, float x, float y ) {
+	const byte	*d;
+	float		fx, fy, w00, w10, w01, w11;
+	int			i, j, c;
+
+	i = (int)floor( x );
+	j = (int)floor( y );
+	if ( i < 0 || j < 0 || i >= HOLE_GRID - 1 || j >= HOLE_GRID - 1 ) {
+		return -WORLD_HOLE_BIAS;
+	}
+
+	fx = x - i;
+	fy = y - j;
+	if ( fx >= fy ) {
+		w00 = 1 - fx;
+		w10 = fx - fy;
+		w01 = 0;
+		w11 = fy;
+	} else {
+		w00 = 1 - fy;
+		w10 = 0;
+		w01 = fy - fx;
+		w11 = fx;
+	}
+
+	c = j * HOLE_GRID + i;
+	d = hole->pub.depth;
+	return w00 * d[c] + w10 * d[c + 1] + w01 * d[c + HOLE_GRID] + w11 * d[c + HOLE_GRID + 1] - WORLD_HOLE_BIAS;
+}
+
+// whether everything from the plane down to need units behind it is carved
+static qboolean CM_HoleCarvedAt( const cHole_t *hole, float x, float y, float need ) {
+	float	depth;
+
+	depth = CM_HoleDepthAt( hole, x, y );
+	return depth >= WORLD_HOLE_RIM && depth >= need;
+}
+
+/*
+================
+CM_HoleBoxCarved
+
+True if a box at p only overlaps the crater of the hole, as far as the given brush is concerned.
+================
+*/
+static qboolean CM_HoleBoxCarved( const cHole_t *hole, const cbrush_t *brush, const vec3_t p, const vec3_t extents ) {
+	float		a, b, h, ea, eb, en, front, need, x, y, x0, x1, y0, y1;
+	int			i, j, k;
+
+	CM_HoleLocal( &hole->pub, p, &a, &b, &h );
+	ea = fabs( extents[0] * hole->pub.axis[0] ) + fabs( extents[1] * hole->pub.axis[1] ) + fabs( extents[2] * hole->pub.axis[2] );
+	eb = fabs( extents[0] * hole->pub.up[0] ) + fabs( extents[1] * hole->pub.up[1] ) + fabs( extents[2] * hole->pub.up[2] );
+	en = fabs( extents[0] * hole->pub.normal[0] ) + fabs( extents[1] * hole->pub.normal[1] ) + fabs( extents[2] * hole->pub.normal[2] );
+
+	// wall brushes are only carved behind the plane, clip brushes also a little in front of it
+	front = ( brush->contents & CONTENTS_SOLID ) ? 0 : HOLE_CLIP_REACH;
+	if ( h - en > front + 1 ) {
+		return qfalse;
+	}
+	need = en - h;
+
+	x0 = ( a - ea ) / HOLE_CELL + HOLE_GRID / 2;
+	x1 = ( a + ea ) / HOLE_CELL + HOLE_GRID / 2;
+	y0 = ( b - eb ) / HOLE_CELL + HOLE_GRID / 2;
+	y1 = ( b + eb ) / HOLE_CELL + HOLE_GRID / 2;
+	if ( x0 < 0 || y0 < 0 || x1 > HOLE_GRID - 1 || y1 > HOLE_GRID - 1 ) {
+		return qfalse;
+	}
+
+	// the depth is linear over each triangle, so it is shallowest at a corner of the box, a grid point inside it, or where a grid line or diagonal crosses its edges
+	for ( j = (int)ceil( y0 ) ; j <= y1 ; j++ ) {
+		for ( i = (int)ceil( x0 ) ; i <= x1 ; i++ ) {
+			if ( !CM_HoleCarvedAt( hole, i, j, need ) ) {
+				return qfalse;
+			}
+		}
+	}
+	for ( k = 0 ; k < 2 ; k++ ) {
+		y = k ? y1 : y0;
+		if ( !CM_HoleCarvedAt( hole, x0, y, need ) || !CM_HoleCarvedAt( hole, x1, y, need ) ) {
+			return qfalse;
+		}
+		for ( i = (int)ceil( x0 ) ; i <= x1 ; i++ ) {
+			if ( !CM_HoleCarvedAt( hole, i, y, need ) ) {
+				return qfalse;
+			}
+		}
+		for ( i = (int)ceil( x0 - y ) ; i <= x1 - y ; i++ ) {
+			if ( !CM_HoleCarvedAt( hole, y + i, y, need ) ) {
+				return qfalse;
+			}
+		}
+
+		x = k ? x1 : x0;
+		for ( j = (int)ceil( y0 ) ; j <= y1 ; j++ ) {
+			if ( !CM_HoleCarvedAt( hole, x, j, need ) ) {
+				return qfalse;
+			}
+		}
+		for ( j = (int)ceil( x - y1 ) ; j <= x - y0 ; j++ ) {
+			if ( !CM_HoleCarvedAt( hole, x, x - j, need ) ) {
+				return qfalse;
+			}
+		}
+	}
+	return qtrue;
+}
+
+static qboolean CM_BrushInHole( const cbrush_t *brush, int num ) {
+	return ( brush->holeBits[num >> 5] & ( 1 << ( num & 31 ) ) ) != 0;
+}
+
+// whether hole was blasted into the same face of the wall as face
+static qboolean CM_HoleInFace( const worldHole_t *hole, const worldHole_t *face ) {
+	return face && DotProduct( hole->normal, face->normal ) > 0.99f
+		&& fabs( DotProduct( hole->origin, face->normal ) - DotProduct( face->origin, face->normal ) ) < 1;
+}
+
+qboolean CM_PointInBrushHoles( const cbrush_t *brush, const vec3_t p, const vec3_t extents ) {
+	int		i;
+
+	if ( cm.ignoreHoles ) {
+		return qfalse;
+	}
+	for ( i = 0 ; i < cm.numHoles ; i++ ) {
+		if ( CM_BrushInHole( brush, i ) && !CM_HoleInFace( &cm.holes[i].pub, cm.ignoreFace )
+			&& CM_HoleBoxCarved( &cm.holes[i], brush, p, extents ) ) {
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+static int CM_TraceCarvedHole( const traceWork_t *tw, const cbrush_t *brush, float t ) {
+	vec3_t	p;
+	int		i;
+
+	for ( i = 0 ; i < 3 ; i++ ) {
+		p[i] = tw->start[i] + t * ( tw->end[i] - tw->start[i] );
+	}
+	for ( i = 0 ; i < cm.numHoles ; i++ ) {
+		if ( CM_BrushInHole( brush, i ) && CM_HoleBoxCarved( &cm.holes[i], brush, p, tw->extents ) ) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+/*
+================
+CM_HoleExitNormal
+
+Which side of the crater a trace ran into between fractions good and bad.
+================
+*/
+static void CM_HoleExitNormal( const traceWork_t *tw, const cbrush_t *brush, const cHole_t *hole,
+	float good, float bad, vec3_t normal ) {
+	vec3_t	g, d, p;
+	float	moves[3];
+	int		i, largest;
+
+	for ( i = 0 ; i < 3 ; i++ ) {
+		g[i] = tw->start[i] + good * ( tw->end[i] - tw->start[i] );
+		d[i] = ( bad - good ) * ( tw->end[i] - tw->start[i] );
+	}
+	moves[0] = DotProduct( d, hole->pub.axis );
+	moves[1] = DotProduct( d, hole->pub.up );
+	moves[2] = DotProduct( d, hole->pub.normal );
+
+	// move along one grid direction at a time to see which one hits material
+	VectorMA( g, moves[0], hole->pub.axis, p );
+	if ( !CM_HoleBoxCarved( hole, brush, p, tw->extents ) ) {
+		VectorScale( hole->pub.axis, moves[0] > 0 ? -1 : 1, normal );
+		return;
+	}
+	VectorMA( g, moves[1], hole->pub.up, p );
+	if ( !CM_HoleBoxCarved( hole, brush, p, tw->extents ) ) {
+		VectorScale( hole->pub.up, moves[1] > 0 ? -1 : 1, normal );
+		return;
+	}
+	VectorMA( g, moves[2], hole->pub.normal, p );
+	if ( !CM_HoleBoxCarved( hole, brush, p, tw->extents ) ) {
+		VectorScale( hole->pub.normal, moves[2] > 0 ? -1 : 1, normal );
+		return;
+	}
+
+	// a corner: blame the direction it moved furthest in
+	largest = 0;
+	for ( i = 1 ; i < 3 ; i++ ) {
+		if ( fabs( moves[i] ) > fabs( moves[largest] ) ) {
+			largest = i;
+		}
+	}
+	if ( largest == 0 ) {
+		VectorScale( hole->pub.axis, moves[0] > 0 ? -1 : 1, normal );
+	} else if ( largest == 1 ) {
+		VectorScale( hole->pub.up, moves[1] > 0 ? -1 : 1, normal );
+	} else {
+		VectorScale( hole->pub.normal, moves[2] > 0 ? -1 : 1, normal );
+	}
+}
+
+/*
+================
+CM_TraceThroughBrushHoles
+
+Finishes CM_TraceThroughBrush for a brush with holes in it: the trace only stops where it meets brush volume that has not been carved away.
+================
+*/
+void CM_TraceThroughBrushHoles( traceWork_t *tw, cbrush_t *brush, float enterFrac, float leaveFrac,
+	qboolean startout, qboolean getout, cplane_t *clipplane, cbrushside_t *leadside ) {
+	vec3_t		delta, point;
+	cplane_t	plane;
+	float		t, end, length, step, good, bad, mid;
+	int			i, num, holeNum;
+
+	if ( startout ) {
+		if ( enterFrac >= leaveFrac || enterFrac <= -1 ) {
+			return;
+		}
+		t = enterFrac < 0 ? 0 : enterFrac;
+		end = leaveFrac;
+	} else {
+		t = 0;
+		end = getout ? leaveFrac : 1;
+	}
+
+	holeNum = CM_TraceCarvedHole( tw, brush, t );
+	if ( holeNum < 0 ) {
+		if ( !startout ) {
+			tw->trace.startsolid = qtrue;
+			if ( !getout ) {
+				tw->trace.allsolid = qtrue;
+				tw->trace.fraction = 0;
+				tw->trace.contents = brush->contents;
+			}
+			return;
+		}
+
+		if ( enterFrac < tw->trace.fraction ) {
+			if ( enterFrac < 0 ) {
+				enterFrac = 0;
+			}
+			tw->trace.fraction = enterFrac;
+			if ( clipplane != NULL ) {
+				tw->trace.plane = *clipplane;
+			}
+			if ( leadside != NULL ) {
+				tw->trace.surfaceFlags = leadside->surfaceFlags;
+			}
+			tw->trace.contents = brush->contents;
+		}
+		return;
+	}
+
+	// starting within SURFACE_CLIP_EPSILON of the face it leaves through, it is already out
+	if ( end <= t ) {
+		return;
+	}
+
+	VectorSubtract( tw->end, tw->start, delta );
+	length = VectorLength( delta );
+	step = length > HOLE_TRACE_STEP ? HOLE_TRACE_STEP / length : 1;
+
+	// walk through the crater until the trace meets material that is still there
+	good = t;
+	for ( ;; ) {
+		bad = MIN( good + step, end );
+		num = CM_TraceCarvedHole( tw, brush, bad );
+		if ( num < 0 ) {
+			break;
+		}
+		if ( bad >= end ) {
+			return;
+		}
+		good = bad;
+		holeNum = num;
+	}
+
+	for ( i = 0 ; i < 10 ; i++ ) {
+		mid = ( good + bad ) * 0.5f;
+		num = CM_TraceCarvedHole( tw, brush, mid );
+		if ( num < 0 ) {
+			bad = mid;
+		} else {
+			good = mid;
+			holeNum = num;
+		}
+	}
+
+	t = good;
+	if ( length > 0 ) {
+		t -= SURFACE_CLIP_EPSILON / length;
+	}
+	if ( t < 0 ) {
+		t = 0;
+	}
+	if ( t >= tw->trace.fraction ) {
+		return;
+	}
+
+	VectorMA( tw->start, t, delta, point );
+	CM_HoleExitNormal( tw, brush, &cm.holes[holeNum], good, bad, plane.normal );
+	plane.dist = DotProduct( point, plane.normal );
+	plane.type = PlaneTypeForNormal( plane.normal );
+	SetPlaneSignbits( &plane );
+
+	tw->trace.fraction = t;
+	tw->trace.plane = plane;
+	tw->trace.surfaceFlags = leadside ? leadside->surfaceFlags : 0;
+	tw->trace.contents = brush->contents;
+}
+
+static qboolean CM_PointInBrush( const cbrush_t *brush, const vec3_t p ) {
+	int		i;
+
+	if ( !CM_BoundsIntersectPoint( brush->bounds[0], brush->bounds[1], p ) ) {
+		return qfalse;
+	}
+	for ( i = 0 ; i < brush->numsides ; i++ ) {
+		if ( DotProduct( p, brush->sides[i].plane->normal ) > brush->sides[i].plane->dist ) {
+			return qfalse;
+		}
+	}
+	return qtrue;
+}
+
+static void CM_HoleCellBounds( const worldHole_t *hole, int i, int j, float front, float depth, vec3_t mins, vec3_t maxs ) {
+	vec3_t	p;
+	float	a, b;
+	int		k;
+
+	a = ( i - HOLE_GRID / 2 ) * HOLE_CELL;
+	b = ( j - HOLE_GRID / 2 ) * HOLE_CELL;
+	ClearBounds( mins, maxs );
+	for ( k = 0 ; k < 8 ; k++ ) {
+		CM_HolePoint( hole, ( k & 1 ) ? a + HOLE_CELL : a, ( k & 2 ) ? b + HOLE_CELL : b, ( k & 4 ) ? front : -depth, p );
+		AddPointToBounds( p, mins, maxs );
+	}
+}
+
+// deepest cut into the wall at the corners of cell (i,j), or 0 if the crater does not reach into it
+static int CM_HoleCellDepth( const worldHole_t *hole, int i, int j ) {
+	static const int	corners[4] = { 0, 1, HOLE_GRID, HOLE_GRID + 1 };
+	int		k, c, d, deepest;
+
+	deepest = 0;
+	for ( k = 0 ; k < 4 ; k++ ) {
+		c = j * HOLE_GRID + i + corners[k];
+		d = hole->depth[c] - WORLD_HOLE_BIAS;
+		deepest = MAX( deepest, d );
+	}
+	return deepest >= WORLD_HOLE_RIM ? deepest : 0;
+}
+
+static qboolean CM_BrushTouchesHole( const cbrush_t *brush, const worldHole_t *hole ) {
+	static const float	spots[3] = { 0.03f, 0.5f, 0.97f };
+	vec3_t	p, mins, maxs;
+	float	a, b, h, front;
+	int		i, j, x, y, depth;
+
+	// solid brushes are cut inside the wall; clip brushes also in front of it
+	front = ( brush->contents & CONTENTS_SOLID ) ? -0.5f : HOLE_CLIP_REACH;
+
+	for ( j = 0 ; j < HOLE_GRID - 1 ; j++ ) {
+		for ( i = 0 ; i < HOLE_GRID - 1 ; i++ ) {
+			depth = CM_HoleCellDepth( hole, i, j );
+			if ( !depth ) {
+				continue;
+			}
+			CM_HoleCellBounds( hole, i, j, front, depth, mins, maxs );
+			if ( !CM_BoundsIntersect( mins, maxs, brush->bounds[0], brush->bounds[1] ) ) {
+				continue;
+			}
+
+			a = ( i - HOLE_GRID / 2 ) * HOLE_CELL;
+			b = ( j - HOLE_GRID / 2 ) * HOLE_CELL;
+			for ( h = front ; h > -depth ; h -= 2 ) {
+				for ( y = 0 ; y < 3 ; y++ ) {
+					for ( x = 0 ; x < 3 ; x++ ) {
+						CM_HolePoint( hole, a + spots[x] * HOLE_CELL, b + spots[y] * HOLE_CELL, h, p );
+						if ( CM_PointInBrush( brush, p ) ) {
+							return qtrue;
+						}
+					}
+				}
+			}
+		}
+	}
+	return qfalse;
+}
+
+static void CM_CollectHoleBrushes( int num ) {
+	cHole_t		*hole;
+	int			leafs[HOLE_MAX_LEAFS];
+	vec3_t		mins, maxs, cellMins, cellMaxs;
+	cLeaf_t		*leaf;
+	cbrush_t	*b;
+	int			numLeafs, lastLeaf, i, j, k, depth, brushnum;
+
+	hole = &cm.holes[num];
+	ClearBounds( mins, maxs );
+	for ( j = 0 ; j < HOLE_GRID - 1 ; j++ ) {
+		for ( i = 0 ; i < HOLE_GRID - 1 ; i++ ) {
+			depth = CM_HoleCellDepth( &hole->pub, i, j );
+			if ( depth ) {
+				CM_HoleCellBounds( &hole->pub, i, j, HOLE_CLIP_REACH, depth, cellMins, cellMaxs );
+				AddPointToBounds( cellMins, mins, maxs );
+				AddPointToBounds( cellMaxs, mins, maxs );
+			}
+		}
+	}
+
+	numLeafs = CM_BoxLeafnums( mins, maxs, leafs, HOLE_MAX_LEAFS, &lastLeaf );
+	for ( i = 0 ; i < numLeafs ; i++ ) {
+		leaf = &cm.leafs[leafs[i]];
+		for ( k = 0 ; k < leaf->numLeafBrushes ; k++ ) {
+			brushnum = cm.leafbrushes[leaf->firstLeafBrush + k];
+			b = &cm.brushes[brushnum];
+			if ( b->checkcount == cm.checkcount ) {
+				continue;
+			}
+			b->checkcount = cm.checkcount;
+
+			if ( !( b->contents & HOLE_CARVE_CONTENTS ) || CM_BrushInHole( b, num ) ) {
+				continue;
+			}
+			if ( hole->numBrushes == MAX_HOLE_BRUSHES ) {
+				return;
+			}
+			if ( CM_BrushTouchesHole( b, &hole->pub ) ) {
+				hole->brushes[hole->numBrushes++] = brushnum;
+				b->holeBits[num >> 5] |= 1 << ( num & 31 );
+			}
+		}
+	}
+}
+
+/*
+================
+CM_ProbeHolePoint
+
+Whether a grid point is on the wall. Points under a floor, behind other geometry or over open air are never carved.
+================
+*/
+static void CM_ProbeHolePoint( cHole_t *hole, int i, int j ) {
+	static const float	spots[5][2] = { { 0, 0 }, { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } };
+	worldHole_t	*pub;
+	vec3_t		p;
+	float		a, b;
+	int			cell, k;
+
+	pub = &hole->pub;
+	cell = j * HOLE_GRID + i;
+	if ( pub->flags[cell] & HOLECELL_PROBED ) {
+		return;
+	}
+	pub->flags[cell] |= HOLECELL_PROBED;
+
+	a = ( i - HOLE_GRID / 2 ) * HOLE_CELL;
+	b = ( j - HOLE_GRID / 2 ) * HOLE_CELL;
+	CM_HolePoint( pub, a, b, -1, p );
+	if ( !( CM_PointContents( p, 0 ) & CONTENTS_SOLID ) ) {
+		return;
+	}
+	pub->flags[cell] |= HOLECELL_SOLID;
+
+	for ( k = 0 ; k < 5 ; k++ ) {
+		CM_HolePoint( pub, a + spots[k][0], b + spots[k][1], 2, p );
+		if ( CM_PointContents( p, 0 ) & CONTENTS_SOLID ) {
+			return;
+		}
+		if ( !k && CM_LeafCluster( CM_PointLeafnum( p ) ) == -1 ) {
+			return;
+		}
+	}
+	pub->flags[cell] |= HOLECELL_EXPOSED;
+}
+
+static int	holeCarving;							// counts carvings
+static int	holeMeasured[HOLE_GRID * HOLE_GRID];	// the carving holeThickness was measured for
+static int	holeThickness[HOLE_GRID * HOLE_GRID];
+
+/*
+================
+CM_HoleThickness
+
+The rock left behind grid point (i,j), measured up to most units. Holes in the same face are ignored, but not those blasted into the wall from the other side, so that the two never meet.
+================
+*/
+static int CM_HoleThickness( const cHole_t *hole, int i, int j, int most ) {
+	vec3_t		p;
+	qboolean	ignore;
+	int			cell, t;
+
+	cell = j * HOLE_GRID + i;
+	if ( holeMeasured[cell] == holeCarving ) {
+		return holeThickness[cell];
+	}
+	holeMeasured[cell] = holeCarving;
+
+	ignore = cm.ignoreHoles;
+	cm.ignoreHoles = qfalse;
+	cm.ignoreFace = &hole->pub;
+	for ( t = 2 ; t <= most ; t++ ) {
+		CM_HolePoint( &hole->pub, ( i - HOLE_GRID / 2 ) * HOLE_CELL, ( j - HOLE_GRID / 2 ) * HOLE_CELL, -t, p );
+		if ( !( CM_PointContents( p, 0 ) & CONTENTS_SOLID ) ) {
+			break;
+		}
+	}
+	cm.ignoreHoles = ignore;
+	cm.ignoreFace = NULL;
+
+	holeThickness[cell] = t;
+	return t;
+}
+
+/*
+================
+CM_HoleThinnest
+
+The thinnest wall behind point (i,j) and the points around it. The depth in between is interpolated, so a point may not be carved deeper than the wall next to it allows either.
+================
+*/
+static int CM_HoleThinnest( cHole_t *hole, int i, int j, int most ) {
+	int		x, y, thinnest;
+
+	thinnest = most + 1;
+	for ( y = j - 1 ; y <= j + 1 ; y++ ) {
+		for ( x = i - 1 ; x <= i + 1 ; x++ ) {
+			CM_ProbeHolePoint( hole, x, y );
+			if ( hole->pub.flags[y * HOLE_GRID + x] & HOLECELL_SOLID ) {
+				thinnest = MIN( thinnest, CM_HoleThickness( hole, x, y, most ) );
+			}
+		}
+	}
+	return thinnest;
+}
+
+/*
+================
+CM_FindHole
+
+An existing hole the impact belongs to: next to its crater (whatever side of it got hit), or on its wall with room for a whole blast.
+================
+*/
+static int CM_FindHole( const vec3_t impact, const vec3_t normal, float radius ) {
+	const worldHole_t	*hole;
+	float				a, b, h;
+	int					num, i, j, di, dj;
+
+	for ( num = 0 ; num < cm.numHoles ; num++ ) {
+		hole = &cm.holes[num].pub;
+		// a hit on the back of a thin wall makes a hole of its own
+		if ( DotProduct( normal, hole->normal ) < -0.5f ) {
+			continue;
+		}
+		CM_HoleLocal( hole, impact, &a, &b, &h );
+		i = (int)floor( a / HOLE_CELL + 0.5f ) + HOLE_GRID / 2;
+		j = (int)floor( b / HOLE_CELL + 0.5f ) + HOLE_GRID / 2;
+		if ( i < 0 || j < 0 || i >= HOLE_GRID || j >= HOLE_GRID ) {
+			continue;
+		}
+
+		if ( h <= 4 && h >= -hole->maxDepth - 4 ) {
+			for ( dj = -3 ; dj <= 3 ; dj++ ) {
+				for ( di = -3 ; di <= 3 ; di++ ) {
+					if ( i + di >= 0 && j + dj >= 0 && i + di < HOLE_GRID && j + dj < HOLE_GRID
+						&& hole->depth[( j + dj ) * HOLE_GRID + i + di] >= WORLD_HOLE_BIAS + WORLD_HOLE_RIM ) {
+						return num;
+					}
+				}
+			}
+		}
+
+		if ( fabs( h ) <= 2 && DotProduct( normal, hole->normal ) > 0.95f
+			&& fabs( a ) < HOLE_HALF - radius * 2 && fabs( b ) < HOLE_HALF - radius * 2 ) {
+			return num;
+		}
+	}
+	return -1;
+}
+
+/*
+================
+CM_FaceShader
+
+The shader of the visible brush face nearest in front of surface, a point inside the wall, facing within reach of normal and at most search units out.
+================
+*/
+static const char *CM_FaceShader( const vec3_t surface, const vec3_t normal, float minFacing, float search ) {
+	const cbrush_t		*brush;
+	const cbrushside_t	*side, *best;
+	float				d, bestDist;
+	int					i, k;
+
+	best = NULL;
+	bestDist = search;
+	for ( i = 0 ; i < cm.numBrushes ; i++ ) {
+		brush = &cm.brushes[i];
+		if ( !( brush->contents & CONTENTS_SOLID ) || !CM_PointInBrush( brush, surface ) ) {
+			continue;
+		}
+		for ( k = 0 ; k < brush->numsides ; k++ ) {
+			side = &brush->sides[k];
+			if ( ( side->surfaceFlags & ( SURF_NODRAW | SURF_SKY ) )
+				|| DotProduct( side->plane->normal, normal ) < minFacing ) {
+				continue;
+			}
+			d = side->plane->dist - DotProduct( surface, side->plane->normal );
+			if ( d < bestDist ) {
+				bestDist = d;
+				best = side;
+			}
+		}
+	}
+	return best ? cm.shaders[best->shaderNum].shader : NULL;
+}
+
+/*
+================
+CM_HoleMaterial
+
+The shader of the visible brush face the blast struck at surface, a point just inside the wall.
+================
+*/
+static void CM_HoleMaterial( cHole_t *hole, const vec3_t surface ) {
+	const char	*shader;
+
+	shader = CM_FaceShader( surface, hole->pub.normal, 0.7f, HOLE_SURFACE_SEARCH );
+	if ( shader ) {
+		Q_strncpyz( hole->pub.material, shader, sizeof( hole->pub.material ) );
+	}
+}
+
+/*
+================
+CM_SurfaceMaterial
+
+The shader of the wall something hit at impact, a point just in front of it, as it was before any blasting: struck inside a crater, the face the crater was blasted into. qfalse if there is no wall there.
+================
+*/
+qboolean CM_SurfaceMaterial( const vec3_t impact, const vec3_t normal, char *material, int size ) {
+	const char	*shader;
+	vec3_t		surface;
+	float		front;
+	qboolean	ignore;
+
+	ignore = cm.ignoreHoles;
+	cm.ignoreHoles = qtrue;
+	for ( front = 0 ; front <= HOLE_SURFACE_SEARCH ; front += 0.25f ) {
+		VectorMA( impact, -front, normal, surface );
+		if ( CM_PointContents( surface, 0 ) & CONTENTS_SOLID ) {
+			break;
+		}
+	}
+	cm.ignoreHoles = ignore;
+	if ( front > HOLE_SURFACE_SEARCH ) {
+		return qfalse;
+	}
+	shader = CM_FaceShader( surface, normal, 0.3f, HOLE_MAX_THICKNESS * 2 );
+	if ( !shader ) {
+		return qfalse;
+	}
+	Q_strncpyz( material, shader, size );
+	return qtrue;
+}
+
+static qboolean CM_NewHole( cHole_t *hole, const vec3_t impact, const vec3_t normal ) {
+	vec3_t		flat, axis, up, surface;
+	float		front, a, b;
+
+	// walls are carved level, floors, ceilings and slopes straight down or up
+	if ( fabs( normal[2] ) >= 0.7f ) {
+		VectorSet( flat, 0, 0, normal[2] > 0 ? 1 : -1 );
+		VectorSet( axis, 1, 0, 0 );
+		VectorSet( up, 0, 1, 0 );
+	} else {
+		VectorSet( flat, normal[0], normal[1], 0 );
+		if ( VectorNormalize( flat ) == 0 ) {
+			return qfalse;
+		}
+		VectorSet( axis, -flat[1], flat[0], 0 );
+		VectorSet( up, 0, 0, 1 );
+	}
+
+	// the impact point sits slightly in front of the surface it struck
+	for ( front = 0 ; front <= HOLE_SURFACE_SEARCH ; front += 0.25f ) {
+		VectorMA( impact, -front, flat, surface );
+		if ( CM_PointContents( surface, 0 ) & CONTENTS_SOLID ) {
+			break;
+		}
+	}
+	if ( front > HOLE_SURFACE_SEARCH ) {
+		return qfalse;
+	}
+
+	Com_Memset( hole, 0, sizeof( *hole ) );
+	VectorCopy( flat, hole->pub.normal );
+	VectorCopy( axis, hole->pub.axis );
+	VectorCopy( up, hole->pub.up );
+
+	// line the grid up with a world lattice, so holes in the same wall match up
+	a = DotProduct( surface, axis );
+	b = DotProduct( surface, up );
+	VectorMA( surface, HOLE_CELL * floor( a / HOLE_CELL + 0.5f ) - a, axis, hole->pub.origin );
+	VectorMA( hole->pub.origin, HOLE_CELL * floor( b / HOLE_CELL + 0.5f ) - b, up, hole->pub.origin );
+
+	CM_HoleMaterial( hole, surface );
+
+	return qtrue;
+}
+
+/*
+================
+CM_HoleSlot
+
+Where to keep a new hole. Once they are all taken, the oldest hole too narrow for anything to be inside is filled back in. -1 if there is none.
+================
+*/
+static int CM_HoleSlot( void ) {
+	cHole_t		*hole;
+	cbrush_t	*b;
+	int			num, i;
+
+	if ( cm.numHoles < MAX_WORLD_HOLES ) {
+		return cm.numHoles++;
+	}
+
+	// serial goes up with every carving, so the lowest was carved longest ago
+	num = -1;
+	for ( i = 0 ; i < cm.numHoles ; i++ ) {
+		if ( !cm.holes[i].roomy && ( num < 0 || cm.holes[i].pub.serial < cm.holes[num].pub.serial ) ) {
+			num = i;
+		}
+	}
+	if ( num < 0 ) {
+		return -1;
+	}
+
+	hole = &cm.holes[num];
+	for ( i = 0 ; i < hole->numBrushes ; i++ ) {
+		b = &cm.brushes[hole->brushes[i]];
+		b->holeBits[num >> 5] &= ~( 1 << ( num & 31 ) );
+	}
+	return num;
+}
+
+// whether points (i,j) to (i+2,j+2) are all carved
+static qboolean CM_HoleRoomAt( const worldHole_t *hole, int i, int j ) {
+	int		x, y;
+
+	if ( i < 0 || j < 0 || i > HOLE_GRID - 3 || j > HOLE_GRID - 3 ) {
+		return qfalse;
+	}
+	for ( y = j ; y < j + 3 ; y++ ) {
+		for ( x = i ; x < i + 3 ; x++ ) {
+			if ( hole->depth[y * HOLE_GRID + x] < WORLD_HOLE_BIAS + WORLD_HOLE_RIM ) {
+				return qfalse;
+			}
+		}
+	}
+	return qtrue;
+}
+
+/*
+================
+CM_CarveHole
+
+Blows a rough, lumpy bowl out of the wall around the impact. Blasts landing in an existing crater make it wider and deeper, up to a limit; walls are never holed right through. Plasma melts a shallower pit the same way, while bullets and rails, too small for the grid, wear down the points nearest to them: chips that add up into a pit, or a single deep bore.
+================
+*/
+static qboolean CM_CarveHole( cHole_t *hole, const vec3_t impact, float radius, holeKind_t kind ) {
+	worldHole_t	*pub;
+	float		a0, b0, h0, dig, grow, size, deepness, bottom, phase[3], wobble[3];
+	float		dx, dy, dist, ang, edge, want, limit, reach, maxDepth, amount, w;
+	int			i, j, k, i0, i1, j0, j1, cell, depth, most, glowFlags;
+	qboolean	carved, small;
+
+	pub = &hole->pub;
+	CM_HoleLocal( pub, impact, &a0, &b0, &h0 );
+	dig = h0 < 0 ? -h0 : 0;
+
+	small = kind == HOLE_CHIP || kind == HOLE_DRILL;
+	glowFlags = kind == HOLE_CHIP ? HOLECELL_COLD : kind == HOLE_BLAST ? 0 : HOLECELL_PLASMA;
+	maxDepth = radius * ( kind == HOLE_CHIP ? HOLE_CHIP_DEPTH : kind == HOLE_DRILL ? HOLE_BORE_DEPTH
+		: kind == HOLE_MELT ? HOLE_PIT_DEPTH : HOLE_CRATER_DEPTH );
+	// walls thicker than this leave room for the deepest carving
+	most = MIN( (int)ceil( maxDepth ) + HOLE_WALL_LEFT, HOLE_MAX_THICKNESS );
+	holeCarving++;
+	// a single bullet only chips the surface, it takes a few in the same spot to wear a pit
+	amount = kind == HOLE_CHIP ? radius * ( 0.6f + 0.3f * random() ) : radius * ( 2.2f + 0.6f * random() );
+
+	// the deeper the crater already is where this one lands, the wider it gets
+	grow = MIN( dig / maxDepth, 1 );
+	size = small ? radius + HOLE_CELL / 2
+		: radius * ( 0.6f + 0.3f * random() ) * ( 1 + ( kind == HOLE_MELT ? HOLE_PIT_GROWTH : HOLE_CRATER_GROWTH ) * grow );
+	deepness = kind == HOLE_MELT ? 0.35f + 0.1f * random() : 0.35f + 0.15f * random();
+	bottom = dig + deepness * size;
+	for ( k = 0 ; k < 3 ; k++ ) {
+		phase[k] = random() * 2 * M_PI;
+	}
+	wobble[0] = 0.10f + 0.12f * random();
+	wobble[1] = 0.05f + 0.07f * random();
+	wobble[2] = 0.03f + 0.04f * random();
+
+	reach = size * 1.6f + 2 * HOLE_CELL;
+	i0 = MAX( (int)ceil( ( a0 - reach ) / HOLE_CELL ) + HOLE_GRID / 2, 1 );
+	i1 = MIN( (int)floor( ( a0 + reach ) / HOLE_CELL ) + HOLE_GRID / 2, HOLE_GRID - 2 );
+	j0 = MAX( (int)ceil( ( b0 - reach ) / HOLE_CELL ) + HOLE_GRID / 2, 1 );
+	j1 = MIN( (int)floor( ( b0 + reach ) / HOLE_CELL ) + HOLE_GRID / 2, HOLE_GRID - 2 );
+
+	carved = qfalse;
+	for ( j = j0 ; j <= j1 ; j++ ) {
+		for ( i = i0 ; i <= i1 ; i++ ) {
+			dx = ( i - HOLE_GRID / 2 ) * HOLE_CELL - a0;
+			dy = ( j - HOLE_GRID / 2 ) * HOLE_CELL - b0;
+			dist = sqrt( dx * dx + dy * dy );
+			ang = atan2( dy, dx );
+
+			// a lumpy outline with a crumbly edge
+			edge = size;
+			if ( !small ) {
+				edge *= ( 1 + wobble[0] * sin( 2 * ang + phase[0] ) + wobble[1] * sin( 3 * ang + phase[1] )
+					+ wobble[2] * sin( 5 * ang + phase[2] ) ) * ( 0.9f + 0.2f * random() );
+			}
+			cell = j * HOLE_GRID + i;
+
+			if ( dist >= edge ) {
+				// outside the crater: how far out, so the edge interpolates to the right place
+				depth = -( dist - edge ) * HOLE_EDGE_SLOPE;
+			} else {
+				CM_ProbeHolePoint( hole, i, j );
+				if ( !( pub->flags[cell] & HOLECELL_EXPOSED ) ) {
+					depth = -HOLE_CELL;
+				} else {
+					if ( small ) {
+						// worn down from where it is, the nearer the hit the more
+						w = 1 - dist / edge;
+						want = MAX( pub->depth[cell] - WORLD_HOLE_BIAS, 0 ) + amount * w * ( 0.8f + 0.4f * random() );
+					} else {
+						want = bottom * sqrt( 1 - dist * dist / ( edge * edge ) ) * ( 0.85f + 0.3f * random() );
+					}
+					limit = MIN( maxDepth, CM_HoleThinnest( hole, i, j, most ) - HOLE_WALL_LEFT );
+					depth = MIN( want, limit );
+				}
+			}
+
+			depth = Com_Clamp( 0, 255, depth + WORLD_HOLE_BIAS );
+			if ( depth > pub->depth[cell] ) {
+				pub->depth[cell] = depth;
+				pub->flags[cell] = ( pub->flags[cell] & ~( HOLECELL_COLD | HOLECELL_PLASMA ) ) | glowFlags;
+				depth -= WORLD_HOLE_BIAS;
+				if ( depth > pub->maxDepth ) {
+					pub->maxDepth = depth;
+				}
+				// chips too small to see yet still count, for the next ones to wear deeper
+				if ( depth >= ( small ? 1 : WORLD_HOLE_RIM ) ) {
+					carved = qtrue;
+				}
+			}
+		}
+	}
+
+	if ( carved ) {
+		pub->serial = ++holeSerial;
+	}
+
+	// anything as wide as a player or an item needs a block of 3 by 3 carved points to be inside
+	for ( j = j0 - 2 ; j <= j1 && !hole->roomy ; j++ ) {
+		for ( i = i0 - 2 ; i <= i1 && !hole->roomy ; i++ ) {
+			hole->roomy = CM_HoleRoomAt( pub, i, j );
+		}
+	}
+	return carved;
+}
+
+/*
+================
+CM_AddWorldHole
+
+Blasts a crater into the world at origin, struck from the side normal points to. Returns the hole number, or -1 if nothing was carved.
+================
+*/
+int CM_AddWorldHole( const vec3_t origin, const vec3_t normal, float radius, holeKind_t kind ) {
+	static cHole_t	fresh;
+	vec3_t	n;
+	int		num;
+
+	if ( !cm.numNodes || radius <= 0 || VectorNormalize2( normal, n ) == 0 ) {
+		return -1;
+	}
+
+	// measure the walls as they were built; CM_HoleThickness measures what carving left
+	cm.ignoreHoles = qtrue;
+
+	num = CM_FindHole( origin, n, radius );
+	if ( num >= 0 ) {
+		if ( !CM_CarveHole( &cm.holes[num], origin, radius, kind ) ) {
+			num = -1;
+		}
+	} else if ( CM_NewHole( &fresh, origin, n ) && CM_CarveHole( &fresh, origin, radius, kind ) ) {
+		// only now that something was carved may it take the place of an old one
+		num = CM_HoleSlot();
+		if ( num >= 0 ) {
+			cm.holes[num] = fresh;
+		}
+	}
+
+	cm.ignoreHoles = qfalse;
+
+	if ( num >= 0 ) {
+		CM_CollectHoleBrushes( num );
+	}
+	return num;
+}
+
+void CM_ClearWorldHoles( void ) {
+	int		i;
+
+	for ( i = 0 ; i < cm.numBrushes ; i++ ) {
+		Com_Memset( cm.brushes[i].holeBits, 0, sizeof( cm.brushes[i].holeBits ) );
+	}
+	cm.numHoles = 0;
+}
+
+int CM_NumWorldHoles( void ) {
+	return cm.numHoles;
+}
+
+const worldHole_t *CM_GetWorldHole( int num ) {
+	if ( num < 0 || num >= cm.numHoles ) {
+		return NULL;
+	}
+	return &cm.holes[num].pub;
+}
